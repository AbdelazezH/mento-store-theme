{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_color = section.settings.color_scheme.settings.secondary %}

{% case section.settings.banner_type %}
    {% when 'first' %}
        {% render 'multi-image-banner-type-1', background: background %}
    {% when 'second' %}
        {% render 'multi-image-banner-type-2', background: background, primary_color: primary_color, secondary_color: secondary_color %}

{% endcase %}

{% schema %}
{
  "name": "t:sections.store-banner-2.name",
  "settings": [
    {
      "type": "select",
      "id": "banner_type",
      "options": [
        {
          "value": "first",
          "label": "t:sections.store-banner-2.settings.banner_type.options.first.label"
        },
        {
          "value": "second",
          "label": "t:sections.store-banner-2.settings.banner_type.options.second.label"
        }
      ],
      "default": "first",
      "label": "t:sections.store-banner-2.settings.banner_type.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-6"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "t:sections.store-banner-2.blocks.banner.name",
      "settings": [
        {
          "type": "header",
          "content": "t:sections.store-banner-2.blocks.banner.settings.header-1.content"
        },
        {
          "id": "banner_image",
          "type": "image_picker",
          "label": "t:sections.store-banner-2.blocks.banner.settings.banner_image.label"
        },
        {
          "id": "banner_title",
          "type": "text",
          "label": "t:sections.store-banner-2.blocks.banner.settings.banner_title.label",
          "default": "t:sections.store-banner-2.blocks.banner.settings.banner_title.default"
        },
        {
          "id": "sub",
          "type": "text",
          "label": "t:sections.store-banner-2.blocks.banner.settings.sub.label"
        },
        {
          "id": "banner_btn",
          "type": "text",
          "label": "t:sections.store-banner-2.blocks.banner.settings.banner_btn.label",
          "default": "t:sections.store-banner-2.blocks.banner.settings.banner_btn.default"
        },
        {
          "id": "banner_url",
          "type": "url",
          "label": "t:sections.store-banner-2.blocks.banner.settings.banner_url.label",
          "default": "/collections/all"
        },
        {
          "type": "header",
          "content": "t:sections.store-banner-2.blocks.banner.settings.header-2.content"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.color_scheme.label",
          "default": "scheme-8"
        },
        {
          "type": "select",
          "id": "justify_content",
          "label": "t:sections.store-banner-2.blocks.banner.settings.justify_content.label",
          "default": "justify-center",
          "options": [
            {
              "value": "justify-right",
              "label": "t:sections.store-banner-2.blocks.banner.settings.justify_content.options.justify-right.label"
            },
            {
              "value": "justify-center",
              "label": "t:sections.store-banner-2.blocks.banner.settings.justify_content.options.justify-center.label"
            },
            {
              "value": "justify-left",
              "label": "t:sections.store-banner-2.blocks.banner.settings.justify_content.options.justify-left.label"
            }
          ]
        },
        {
          "type": "select",
          "id": "align_items",
          "label": "t:sections.store-banner-2.blocks.banner.settings.align_items.label",
          "default": "items-center",
          "options": [
            {
              "value": "items-start",
              "label": "t:sections.store-banner-2.blocks.banner.settings.align_items.options.items-start.label"
            },
            {
              "value": "items-center",
              "label": "t:sections.store-banner-2.blocks.banner.settings.align_items.options.items-center.label"
            },
            {
              "value": "items-end",
              "label": "t:sections.store-banner-2.blocks.banner.settings.align_items.options.items-end.label"
            }
          ]
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "t:sections.store-banner-2.blocks.banner.settings.text_align.label",
          "default": "text-center",
          "options": [
            {
              "value": "text-right",
              "label": "t:sections.store-banner-2.blocks.banner.settings.text_align.options.text-right.label"
            },
            {
              "value": "text-center",
              "label": "t:sections.store-banner-2.blocks.banner.settings.text_align.options.text-center.label"
            },
            {
              "value": "text-left",
              "label": "t:sections.store-banner-2.blocks.banner.settings.text_align.options.text-left.label"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.store-banner-2.name",
      "blocks": [
        {
          "type": "banner"
        },
        {
          "type": "banner"
        },
        {
          "type": "banner"
        }
      ]
    }
  ]
}
{% endschema %}