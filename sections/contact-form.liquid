{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_color = section.settings.color_scheme.settings.secondary %}
{% assign secondary_light_color = section.settings.color_scheme.settings.secondary_light %}
{% assign secondary_lighter_color = section.settings.color_scheme.settings.secondary_lighter %}
{% assign button_label = section.settings.color_scheme.settings.button_label %}
{% assign button_bg = section.settings.color_scheme.settings.button %}
{% assign border_color = section.settings.color_scheme.settings.button_border %}
{% assign secondary_button_label = section.settings.color_scheme.settings.secondary_button_label %}
{% assign secondary_button_bg = section.settings.color_scheme.settings.secondary_button %}

<style>
    .contact_placeholder_color::placeholder {
        color: {{ secondary_lighter_color }} !important;
    }

    .btn__submit {
        background-color: {{ button_bg }};
        color: {{ button_label }};
        border-color: {{ border_color }};
    }

    .btn__submit:hover {
        background-color: {{ secondary_button_bg }};
        color: {{ secondary_button_label }};
    }
</style>

<div class="bg-white mx-auto" style="background-color: {{ background }};">
    <div class="flex items-center justify-center px-2 md:px-8 pt-8 pb-16 md:pt-16 md:pb-20">
        <div class="max-w-xl w-full flex flex-col gap-6 md:gap-14">
            <div class="max-w-sm self-center flex flex-col justify-center items-center gap-5 md:gap-6 text-center">
                <h1 class="text-2xl/snug md:text-3xl/snug font-normal md:font-medium text-primary-main"
                    style="color: {{ primary_color }};">
                    {{ section.settings.title }}
                </h1>

                {% if section.settings.sub != blank %}
                    <p class="text-base/snug font-normal text-gray-900"
                       style="color: {{ secondary_color }};">
                        {{ section.settings.sub }}
                    </p>
                {% endif %}
            </div>

            {% form 'contact', class: 'flex flex-col' %}

                {% if form.errors %}
                    {% render 'alert', type: 'error', text: 'pages.contact.error' %}
                {% elsif form.posted_successfully? %}
                    {% render 'alert', type: 'success', text: 'pages.contact.success' %}
                {% endif %}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-0 md:gap-6">
                    <div class="my-2.5">
                        <label for="contact_name" class="block text-base mb-3.5" style="color: {{ secondary_color }};">
                            {{ 'pages.contact.name' | t }} <span class="text-red-600">*</span>
                        </label>

                        <input type="text" id="contact_name" name="contact[name]" autocomplete="name"
                               placeholder="{{ 'pages.contact.name_placeholder' | t }}" required
                               class="relative block w-full text-base font-normal placeholder:text-gray-500 bg-transparent placeholder:text-base rounded-sm px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main contact_placeholder_color"
                               style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                    </div>

                    <div class="my-2.5">
                        <label for="contact_email" class="block text-base mb-3.5" style="color: {{ secondary_color }};">
                            {{ 'pages.contact.email' | t }} <span class="text-red-600">*</span>
                        </label>

                        <input type="email" id="contact_email" name="contact[email]" autocomplete="email"
                               placeholder="{{ 'pages.contact.email_placeholder' | t }}" required
                               class="relative block w-full text-base font-normal placeholder:text-gray-500 bg-transparent placeholder:text-base rounded-sm px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main contact_placeholder_color"
                               style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                    </div>
                </div>

                {% if section.settings.enable_phone %}
                    <div class="my-2.5">
                        <label for="contact_phone" class="block text-base mb-3.5" style="color: {{ secondary_color }};">
                            {{ 'pages.contact.phone' | t }}
                        </label>

                        <input type="tel" id="contact_phone" name="contact[phone]"
                               placeholder="{{ 'pages.contact.phone_placeholder' | t }}"
                               class="relative block w-full text-base font-normal placeholder:text-gray-500 bg-transparent placeholder:text-base placeholder:rtl:text-right rounded-sm px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main contact_placeholder_color"
                               style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                    </div>
                {% endif %}

                {% if section.settings.enable_subject %}
                    <div class="my-2.5">
                        <label for="contact_subject" class="block text-base mb-3.5"
                               style="color: {{ secondary_color }};">
                            {{ 'pages.contact.subject' | t }}
                        </label>

                        <input type="text" id="contact_subject" name="contact[subject]"
                               placeholder="{{ 'pages.contact.subject_placeholder' | t }}"
                               class="relative block w-full text-base font-normal placeholder:text-gray-500 bg-transparent placeholder:text-base rounded-sm px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main contact_placeholder_color"
                               style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                    </div>
                {% endif %}

                <div class="my-2.5">
                    <label for="contact_message" class="block text-base mb-3.5" style="color: {{ secondary_color }};">
                        {{ 'pages.contact.message' | t }} <span class="text-red-600">*</span>
                    </label>

                    <textarea id="contact_message" name="contact[body]"
                              placeholder="{{ 'pages.contact.message_placeholder' | t }}" required
                              class="resize-none relative block w-full h-32 text-base font-normal placeholder:text-gray-500 bg-transparent placeholder:text-base rounded-sm px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main contact_placeholder_color"
                              style="color: {{ secondary_color }}; border-color: {{ border_color }};"
                    ></textarea>
                </div>

                <div class="mt-6 md:mt-10">
                    <button type="submit"
                            class="relative block w-full text-base font-normal text-white border rounded-sm bg-primary-main hover:bg-opacity-90 py-3 btn__submit">
                        {{ 'pages.contact.send' | t }}
                    </button>
                </div>
            {% endform %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "t:pages.contact.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:pages.contact.settings.title.label",
      "default": "t:pages.contact.settings.title.default"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "t:pages.contact.settings.sub.label",
      "info": "t:pages.contact.settings.sub.info"
    },
    {
      "type": "checkbox",
      "id": "enable_phone",
      "label": "t:pages.contact.settings.enable_phone.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_subject",
      "label": "t:pages.contact.settings.enable_subject.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-10"
    }
  ],
  "presets": [
    {
      "name": "t:pages.contact.name"
    }
  ]
}
{% endschema %}