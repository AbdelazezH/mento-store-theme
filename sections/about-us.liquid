{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_light_color = section.settings.color_scheme.settings.secondary_light %}

<div class="bg-white px-2 md:px-6 pt-6 md:pt-8" style="background-color: {{ background }};">
    <!-- Breadcrumbs -->
    <div class="breadcrumbs flex items-center gap-2 page-width">
        <a href="{{ routes.root_url }}"
           class="text-xs md:text-base leading-normal font-normal text-black" style="color: {{ primary_color }};">
            {{ 'general.breadcrumbs.home' | t }}
        </a>
        <span style="color: {{ primary_color }};">
            {% render 'icon-chevron-left', classes: 'size-4 ltr:rotate-180' %}
        </span>
        <span class="text-xs md:text-base leading-normal font-normal text-gray-500"
              style="color: {{ secondary_light_color }};">
            {{ 'general.breadcrumbs.about' | t }}
        </span>
    </div>

    {% if section.settings.enable_image %}
        <div class="mt-6 md:mt-8">
            <div class="w-full page-width">
                {% if section.settings.image != blank %}
                    <div class="relative aspect-w-4 aspect-h-4 md:aspect-w-16 md:aspect-h-7 overflow-hidden rounded-sm md:rounded-md">
                        <img src="{{ section.settings.image | img_url: 'master' }}"
                             alt="{{ section.settings.image.alt }}"
                             class="w-full h-full object-cover object-center"
                             loading="lazy"
                        >
                        <div class="flex justify-center items-center absolute inset-0">
                            <div class="p-3 flex flex-col justify-center items-center bg-black/30 h-40 w-full md:w-1/3 md:h-full">
                                <h1 class="text-3xl md:text-5xl font-medium leading-normal text-white">
                                    {{ 'pages.about.title' | t }}
                                </h1>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="relative border border-gray-400 aspect-w-4 aspect-h-4 md:aspect-w-16 md:aspect-h-7 overflow-hidden rounded-sm md:rounded-md">
                        <img class="h-full w-full object-cover object-center"
                             src="{{ 'lifestyle-2.svg' | asset_url }}"
                             alt="lifestyle-2 placeholder image" loading="lazy"/>
                        <div class="flex justify-center items-center absolute inset-0">
                            <div class="p-3 flex flex-col justify-center items-center bg-black/30 h-40 w-full md:w-1/3 md:h-full">
                                <h1 class="text-3xl md:text-5xl font-medium leading-normal text-white">
                                    {{ 'pages.about.title' | t }}
                                </h1>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>

{% schema %}
{
  "name": "t:pages.about.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_image",
      "default": true,
      "label": "t:pages.about.settings.enable_image.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:pages.about.settings.image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-6"
    }
  ]
}
{% endschema %}