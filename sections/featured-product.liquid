{% if section.settings.product and section.settings.product != blank %}
    {% assign product = section.settings.product %}
    {% assign selected_variant = product.selected_or_first_available_variant %}
{% endif %}

{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_color = section.settings.color_scheme.settings.secondary %}
{% assign secondary_light_color = section.settings.color_scheme.settings.secondary_light %}
{% assign secondary_lighter_color = section.settings.color_scheme.settings.secondary_lighter %}
{% assign button_label = section.settings.color_scheme.settings.button_label %}
{% assign button_bg = section.settings.color_scheme.settings.button %}
{% assign border_color = section.settings.color_scheme.settings.button_border %}

<section class="bg-white px-2 py-6 md:py-8" style="background-color: {{ background }};">
    <div class="flex flex-col md:flex-row justify-start items-center gap-4 sm:gap-6 lg:gap-12 page-width">

        <!-- Product media -->
        <div class="w-full md:w-1/2 md:px-4">

            <!-- for customizer preview -->
            <div class="featured-product__preview">
                <div class="relative border border-gray-400 group aspect-w-4 aspect-h-4 overflow-hidden rounded-sm md:rounded-md">
                    {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover object-center' }}
                    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black transition-opacity duration-300 opacity-100 group-hover:opacity-0"></div>
                </div>
            </div>

            <div id="swiper_{{ section.id }}" class="swiper featured-product__swiper !hidden">
                <div class="swiper-wrapper">
                    {% if section.settings.product and section.settings.product != blank %}
                        {% for media in product.media %}
                            <div class="swiper-slide">
                                {% case media.media_type %}
                                    {% when 'image' %}
                                        <div class="aspect-w-4 aspect-h-4 overflow-hidden rounded-sm md:rounded-md">
                                            <img src="{{ media | img_url: 'large' }}"
                                                 alt="{{ media.preview_image.alt }}"
                                                 class="w-full h-full object-cover object-center"
                                                 loading="lazy"
                                            >
                                        </div>
                                {% endcase %}
                            </div>
                        {% endfor %}
                    {% else %}
                        {% assign placeholder_media = "product-1, product-2, product-3, product-4" | split: ", " %}
                        {% for media in placeholder_media %}
                            <div class="swiper-slide pe-0 md:pe-2">
                                <div class="relative border border-gray-400 group aspect-w-4 aspect-h-4 overflow-hidden rounded-sm md:rounded-md">
                                    {{ media | placeholder_svg_tag: 'w-full h-full object-cover object-center' }}
                                    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black transition-opacity duration-300 opacity-100 group-hover:opacity-0"></div>
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>

                <div class="flex justify-between items-center mt-2 lg:mt-4">
                    <div class="swiper-pagination !text-gray-900 text-sm/6 md:text-base/6 font-medium"
                         dir="ltr" style="color: {{ secondary_color }};"></div>

                    <div class="flex flex-row justify-center items-center gap-2">
                        <div class="swiper-button-prev !m-auto !text-gray-950" style="color: {{ secondary_color }};">
                            {% render 'icon-arrow-long-left', classes: '!w-6 md:!w-7 !h-4 rtl:rotate-180' %}
                        </div>
                        <div class="swiper-button-next !m-auto !text-gray-950" style="color: {{ secondary_color }};">
                            {% render 'icon-arrow-long-right', classes: '!w-6 md:!w-7 !h-4 rtl:rotate-180' %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product details -->
        <div class="w-full md:w-1/2 lg:ps-2 lg:pe-6">
            {% if section.settings.product and section.settings.product != blank %}
                {% assign product_form_id = 'product-form-' | append: section.id %}

                {% form 'product', product, id: product_form_id, novalidate: 'novalidate' %}
                    <input type="hidden" name="id" value="{{ selected_variant.id }}">

                    <div class="py-3 lg:py-6 flex justify-between items-center">

                        <h2 class="text-xl/4 lg:text-3xl/4 font-medium text-gray-950"
                            style="color: {{ secondary_color }};">
                            {{ product.title | escape }}
                        </h2>

                        <div class="flex justify-center items-center gap-2" id="price-{{ section.id }}">
                            <span class="text-lg/4 lg:text-2xl/4 text-primary-main" style="color: {{ primary_color }};">
                                {{ selected_variant.price | money }}
                            </span>
                            <span class="text-sm/4 lg:text-lg/4 text-gray-300 line-through"
                                  style="color: {{ secondary_lighter_color }};">
                                {{ selected_variant.compare_at_price | money }}
                            </span>
                        </div>
                    </div>

                    {% if product.metafields.judgeme %}
                        <div class="py-3 lg:py-6">
                            <div class="flex items-center" id="rating-badge_element">
                                <!-- Start of Judge.me code -->
                                <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}'>
                                    {{ product.metafields.judgeme.badge }}
                                </div>
                                <!-- End of Judge.me code -->
                            </div>
                        </div>
                    {% endif %}

                    {% unless product.has_only_default_variant %}
                        <variant-radios class="py-3 lg:py-6" data-url="{{ product.url }}"
                                        data-section="{{ section.id }}" data-update-url="false">
                            {% for option in product.options_with_values %}
                                <div class="py-2">
                                    <h3 class="text-[13px]/snug md:text-sm/snug lg:text-base/6 text-gray-950"
                                        style="color: {{ secondary_color }};">
                                        {{ option.name | escape }}
                                    </h3>

                                    {% assign isSwatchType = false %}
                                    {% if option.values.size > 0 and option.values[0].swatch and option.values[0].swatch.color %}
                                        {% assign isSwatchType = true %}
                                    {% endif %}

                                    <fieldset class="mt-3 product-form__input">
                                        {% if isSwatchType %}
                                            <div class="flex items-center ps-1.5 md:ps-0 gap-4 lg:gap-5">
                                                {% for value in option.values %}
                                                    {% if value.swatch.color %}
                                                        <label id="{{ section.id }}-{{ value | handleize }}"
                                                               class="relative -m-0.5 flex cursor-pointer items-center justify-center rounded-full p-0.5 focus:outline-none ring-gray-400 color-variant__label">
                                                            <input type="radio" name="{{ option.name }}"
                                                                   id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                                                   value="{{ value | escape }}"
                                                                   {% if option.selected_value == value %}checked{% endif %}
                                                                   class="sr-only">
                                                            <span class="size-5 lg:size-8 bg-gray-400 rounded-full border border-black border-opacity-10"
                                                                  style="background-color: {{ value.swatch.color }};"></span>
                                                        </label>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <div class="flex items-center gap-2 lg:gap-3">
                                                {% for value in option.values %}
                                                    <label class="variant__label relative flex items-center justify-center min-w-8 md:min-w-10 lg:min-w-12 min-h-8 md:min-h-10 lg:min-h-12 rounded-sm border py-1.5 px-1.5 lg:py-3 lg:px-3 text-[10px]/snug md:text-sm/snug text-gray-500 font-normal uppercase hover:bg-gray-50 bg-white cursor-pointer focus:outline-none"
                                                           style="background-color: {{ background }};">
                                                        <input type="radio" value="{{ value | escape }}"
                                                               name="{{ option.name }}"
                                                               id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                                               {% if option.selected_value == value %}checked{% endif %}
                                                               class="sr-only">
                                                        <span>{{ value | escape }}</span>
                                                        <span id="{{ section.id }}-{{ value | handleize }}"
                                                              aria-hidden="true"
                                                              class="hidden pointer-events-none absolute -inset-px rounded-sm border-2 border-gray-200"
                                                              style="border-color: {{ border_color }}; color: {{ border_color }};">
                                                            <svg class="absolute inset-0 h-full w-full stroke-2"
                                                                 viewBox="0 0 100 100" preserveAspectRatio="none"
                                                                 stroke="currentColor">
                                                              <line x1="0" y1="100" x2="100" y2="0"
                                                                    vector-effect="non-scaling-stroke"/>
                                                            </svg>
                                                        </span>
                                                    </label>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </fieldset>
                                </div>
                            {% endfor %}

                            <script type="application/json">{{ product.variants | json }}</script>
                        </variant-radios>
                    {% endunless %}

                    <div class="py-3 lg:py-6">
                        <div class="flex justify-between items-center gap-2 lg:gap-4">
                            <div class="border border-gray-200" style="border-color: {{ border_color }};">
                                <div class="flex items-center gap-x-2" x-data="{
                                        quantity: 1,
                                        init() {
                                           this.$watch('quantity', value => {
                                               if (value <= 1) {
                                                   this.quantity = 1
                                               } else if (value >= 10) {
                                                   this.quantity = 10
                                               } else {
                                                   this.quantity = value
                                               }
                                           })
                                        },
                                        increment() {
                                            this.quantity >= 10 ? this.quantity = 10 : this.quantity++;
                                        },
                                        decrement() {
                                            this.quantity <= 1 ? this.quantity = 1 : this.quantity--;
                                        }

                                    }">
                                    <button x-on:click.prevent="increment()"
                                            x-bind:class="{'opacity-25 cursor-not-allowed': quantity >= 10 }"
                                            class="inline-flex justify-center items-center px-3 lg:px-6 py-[11px] lg:py-[13px]"
                                            style="color: {{ secondary_color }};">
                                        {% render 'icon-plus', classes: 'size-4 lg:size-5' %}
                                    </button>
                                    <span class="w-4 md:w-6 lg:w-8 p-0 bg-transparent border-0 text-base md:text-lg text-primary-main text-center"
                                          x-text="quantity" style="color: {{ primary_color }};"></span>
                                    <label for="quantity-{{ section.id }}" class="sr-only"></label>
                                    <input type="hidden" name="quantity" id="quantity-{{ section.id }}"
                                           class="w-4 md:w-6 lg:w-8 p-0 bg-transparent border-0 outline-none text-base md:text-lg text-primary-main text-center focus:ring-0 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                                           style="-moz-appearance: textfield;"
                                           x-model="quantity" min="1" max="10">
                                    <button x-on:click.prevent="decrement()"
                                            x-bind:class="{'opacity-25 cursor-not-allowed': quantity <= 1}"
                                            class="inline-flex justify-center items-center px-3 lg:px-6 py-[11px] lg:py-[13px]"
                                            style="color: {{ secondary_color }};">
                                        {% render 'icon-minus', classes: 'size-4 lg:size-5' %}
                                    </button>
                                </div>
                            </div>

                            <div class="flex-1">
                                <button type="submit" name="add"
                                        data-text-add-to-cart="{{ 'pages.product.add_to_cart' | t }}"
                                        data-text-out-of-stock="{{ 'pages.product.out_of_stock' | t }}"
                                        class="w-full text-sm/4 lg:text-base/normal font-medium text-white bg-primary-main rounded-sm py-3 disabled:cursor-not-allowed disabled:opacity-25"
                                        {% if selected_variant.available == false %}
                                            disabled
                                        {% endif %}
                                        style="background-color: {{ button_bg }}; color: {{ button_label }};"
                                >
                                    <span>
                                        {% if selected_variant.available == false %}
                                            {{ 'pages.product.out_of_stock' | t }}
                                        {% else %}
                                            {{ 'pages.product.add_to_cart' | t }}
                                        {% endif %}
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="my-6 md:my-8 lg:my-16">
                        <div class="flex items-center gap-x-3 md:gap-x-4">
                            <a href="{{ product.url }}"
                               class="text-sm/6 lg:text-base/6 text-gray-950 font-medium border-b md:border-b-2 pb-1 md:pb-1.5 border-gray-200"
                               style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                                {{ 'sections.featured_product.btn_show_details' | t }}
                            </a>
                            <span style="color: {{ primary_color }};">
                                {% render 'icon-arrow-left', classes: 'size-3 lg:size-4 ltr:rotate-180' %}
                            </span>
                        </div>
                    </div>

                {% endform %}

            {% else %}
                <div class="py-3 lg:py-6 flex justify-between items-center">

                    <h2 class="text-xl/4 lg:text-3xl/4 font-medium text-gray-950" style="color: {{ secondary_color }};">
                        {{ 'sections.featured_product.title_placeholder' | t }}
                    </h2>

                    <div class="flex justify-center items-center gap-2">
                        <span class="text-lg/4 lg:text-2xl/4 text-primary-main" style="color: {{ primary_color }};">
                            {{ 'sections.featured_product.price_placeholder' | t }}
                        </span>
                        <span class="text-sm/4 lg:text-lg/4 text-gray-300 line-through"
                              style="color: {{ secondary_lighter_color }};">
                            {{ 'sections.featured_product.compare_at_price_placeholder' | t }}
                        </span>
                    </div>
                </div>

                <div class="py-3 lg:py-6">
                    <div class="flex items-center">
                        <p class="text-xs/4 md:text-sm/4 lg:text-base/4 text-gray-700 lg:mt-1"
                           style="color: {{ secondary_light_color }};">
                            {{ 'sections.featured_product.rating_placeholder' | t }}
                        </p>

                        <div class="ms-1 flex items-center">
                            {% for i in (1..5) %}
                                {% if forloop.last %}
                                    {% render 'icon-star', classes: 'size-3.5 md:size-4 lg:size-5 text-gray-200' %}
                                {% else %}
                                    {% render 'icon-star', classes: 'size-3.5 md:size-4 lg:size-5 text-primary-gold' %}
                                {% endif %}
                            {% endfor %}
                        </div>

                        <div class="ms-3 lg:ms-4">
                            <p class="text-xs/4 md:text-sm/4 lg:text-base/4 text-gray-700"
                               style="color: {{ secondary_light_color }};">
                                {{ 'sections.featured_product.reviews_placeholder' | t }}
                            </p>
                        </div>
                    </div>
                </div>

                <div class="py-3 lg:py-6">
                    <div class="py-2">
                        <h3 class="text-[13px]/snug md:text-sm/snug lg:text-base/6 text-gray-950"
                            style="color: {{ secondary_color }};">
                            {{ 'sections.featured_product.label_variant_placeholder' | t }}
                        </h3>

                        {% assign placeholder_sizes = "S, L, XL, XXL" | split: ", " %}

                        <fieldset class="mt-2 product-form__input">
                            <div class="flex items-center gap-2 lg:gap-3">
                                {% for size in placeholder_sizes %}
                                    <label class="variant__label relative flex items-center justify-center min-w-8 md:min-w-10 lg:min-w-12 min-h-8 md:min-h-10 lg:min-h-12 rounded-sm border py-1.5 px-1.5 lg:py-3 lg:px-3 text-[10px]/snug md:text-sm/snug text-gray-500 font-normal uppercase hover:bg-gray-50 bg-white cursor-pointer focus:outline-none"
                                           style="background-color: {{ background }};">
                                        <input type="radio" value="{{ size }}"
                                               name="size"
                                                {% if forloop.first %}
                                                    checked
                                                {% endif %}
                                               class="sr-only">
                                        <span>{{ size }}</span>
                                        {% if forloop.last %}
                                            <span class="pointer-events-none absolute -inset-px rounded-sm border-2 border-gray-200 not-available"
                                                  style="border-color: {{ border_color }}; color: {{ border_color }};">
                                                <svg class="inset-0 h-full w-full stroke-2"
                                                     viewBox="0 0 100 100" preserveAspectRatio="none"
                                                     stroke="currentColor">
                                                  <line x1="0" y1="100" x2="100" y2="0"
                                                        vector-effect="non-scaling-stroke"/>
                                                </svg>
                                            </span>
                                        {% endif %}
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>
                </div>

                <div class="py-3 lg:py-6">
                    <div class="flex justify-between items-center gap-2 lg:gap-4">
                        <div class="border border-gray-200" style="border-color: {{ border_color }};">
                            <div class="flex items-center gap-x-2" x-data="{
                                quantity: 1,
                                increment() {
                                    this.quantity >= 10 ? this.quantity = 10 : this.quantity++;
                                },
                                decrement() {
                                    this.quantity <= 1 ? this.quantity = 1 : this.quantity--;
                                }

                            }">
                                <button x-on:click.prevent="increment()"
                                        x-bind:class="{'opacity-25 cursor-not-allowed': quantity >= 10 }"
                                        class="inline-flex justify-center items-center px-3 lg:px-6 py-[11px] lg:py-[13px]"
                                        style="color: {{ secondary_color }};">
                                    {% render 'icon-plus', classes: 'size-4 lg:size-5' %}
                                </button>
                                <span class="w-4 md:w-6 lg:w-8 p-0 bg-transparent border-0 text-base md:text-lg text-primary-main text-center"
                                      x-text="quantity" style="color: {{ primary_color }};"></span>
                                <button x-on:click.prevent="decrement()"
                                        x-bind:class="{'opacity-25 cursor-not-allowed': quantity <= 1}"
                                        class="inline-flex justify-center items-center px-3 lg:px-6 py-[11px] lg:py-[13px]"
                                        style="color: {{ secondary_color }};">
                                    {% render 'icon-minus', classes: 'size-4 lg:size-5' %}
                                </button>
                            </div>
                        </div>

                        <div class="flex-1">
                            <button type="button"
                                    class="w-full text-sm/4 lg:text-base/normal font-medium text-white bg-primary-main rounded-sm py-3 disabled:cursor-not-allowed disabled:opacity-25"
                                    style="background-color: {{ button_bg }}; color: {{ button_label }};">
                                <span>
                                    {{ 'sections.featured_product.add_to_cart' | t }}
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="my-6 md:my-8 lg:my-16">
                    <div class="flex items-center gap-x-3 md:gap-x-4">
                        <button class="text-sm/6 lg:text-base/6 text-gray-950 font-medium border-b md:border-b-2 pb-1 md:pb-1.5 border-gray-200"
                                style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                            {{ 'sections.featured_product.btn_show_details' | t }}
                        </button>
                        <span style="color: {{ primary_color }};">
                            {% render 'icon-arrow-left', classes: 'size-3 lg:size-4 ltr:rotate-180' %}
                        </span>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>


{% schema %}
{
  "name": "t:sections.featured-product.name",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.featured-product.settings.product.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-7"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-product.name"
    }
  ]
}
{% endschema %}