{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_light_color = section.settings.color_scheme.settings.secondary_light %}

{% style %}
    #swiper_{{ section.id }} .swiper-pagination-bullet-active {
        background-color: {{ section.settings.nav_btn_color }};
    }
{% endstyle %}

<section class="bg-white mx-auto py-8 md:py-10" style="background-color: {{ background }};">
    <div class="flex flex-col justify-center items-center gap-8 md:gap-10 page-width">
        <div class="w-full px-12 md:px-0 lg:max-w-xl flex flex-col justify-center items-center text-center gap-6 md:gap-4">
            <h2 class="text-xl md:text-3xl text-gray-900 font-medium" style="color: {{ primary_color }};">
                {{ section.settings.title | escape }}
            </h2>

            {% if section.settings.description != blank %}
                <p class="text-sm/6 md:text-base/6 text-gray-500 font-normal"
                   style="color: {{ secondary_light_color }};">
                    {{ section.settings.description | escape }}
                </p>
            {% endif %}
        </div>

        <!-- for customizer preview -->
        <div class="testimonials__preview">
            <div class="w-full max-w-full relative flex items-center justify-center gap-2 overflow-hidden">
                {% for block in section.blocks limit: 3 %}
                    <div class="relative bg-secondary-light border border-primary-main overflow-hidden shrink-0 w-[90%] md:w-1/2 h-44 md:h-64 px-6 md:px-20 py-4 md:py-12
                            {% if forloop.index == 2 %} opacity-100 scale-100 {% else %} opacity-50 scale-90 max-w-10 md:max-w-full {% endif %}"
                         style="background-color: {{ block.settings.color_scheme.settings.background }}; border-color: {{ block.settings.color_scheme.settings.button_border }};">
                        <div class="w-full h-full flex flex-col justify-between items-center overflow-hidden">
                            <p class="text-center text-xs/6 md:text-base/6 text-gray-900"
                               style="color: {{ block.settings.color_scheme.settings.text }};">
                                "{{ block.settings.testimonial | escape }}"
                            </p>

                            <div class="w-full flex justify-between items-center">
                                <div class="flex justify-start items-center gap-3.5">
                                    <div class="size-7 md:size-14 bg-gray-300 rounded-full"
                                         style="background-color: {{ block.settings.color_scheme.settings.bg_icons }}; border-color: {{ block.settings.color_scheme.settings.button_border }};">
                                        {% if block.settings.customer_img != blank %}
                                            <img src="{{ block.settings.customer_img | img_url: 'master' }}"
                                                 alt="{{ block.settings.customer_img.alt }}"
                                                 class="w-full h-full object-cover object-center rounded-full"
                                                 loading="lazy"
                                            >
                                        {% endif %}
                                    </div>
                                    <p class="text-xs/6 md:text-lg/6 text-gray-900 font-semibold"
                                       style="color: {{ block.settings.color_scheme.settings.text }};">
                                        {{ block.settings.customer_name | escape }}
                                    </p>
                                </div>

                                <p class="text-[10px]/6 md:text-sm/6 text-gray-700"
                                   style="color: {{ block.settings.color_scheme.settings.secondary }};">
                                    {{ block.settings.created_at | escape }}
                                </p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div id="swiper_{{ section.id }}"
             class="swiper w-full relative items-center justify-center testimonials__swiper !hidden"
             data-autoplay="{{ section.settings.enable_autoplay }}">
            <div class="swiper-wrapper">
                {% for block in section.blocks %}
                    <div class="swiper-slide relative bg-secondary-light border border-primary-main overflow-hidden opacity-50 !transition-all duration-300 ease-in-out transform !scale-95 md:!scale-90 !w-[90%] md:!w-1/2 !h-44 md:!h-64 px-6 md:px-20 py-4 md:py-12"
                         style="background-color: {{ block.settings.color_scheme.settings.background }}; border-color: {{ block.settings.color_scheme.settings.button_border }};">
                        <div class="w-full h-full flex flex-col justify-between items-center">
                            <p class="text-center text-xs/6 md:text-base/6 text-gray-900"
                               style="color: {{ block.settings.color_scheme.settings.text }};">
                                "{{ block.settings.testimonial | escape }}"
                            </p>

                            <div class="w-full flex justify-between items-center">
                                <div class="flex justify-start items-center gap-3.5">
                                    {% if block.settings.enable_customer_img %}
                                        <div class="size-7 md:size-14 bg-gray-300 rounded-full"
                                             style="background-color: {{ block.settings.color_scheme.settings.bg_icons }}; border-color: {{ block.settings.color_scheme.settings.button_border }};">
                                            {% if block.settings.customer_img != blank %}
                                                <img src="{{ block.settings.customer_img | img_url: 'master' }}"
                                                     alt="{{ block.settings.customer_img.alt }}"
                                                     class="w-full h-full object-cover object-center rounded-full"
                                                     loading="lazy"
                                                >
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                    <p class="text-xs/6 md:text-lg/6 text-gray-900 font-semibold"
                                       style="color: {{ block.settings.color_scheme.settings.text }};">
                                        {{ block.settings.customer_name | escape }}
                                    </p>
                                </div>

                                <p class="text-[10px]/6 md:text-sm/6 text-gray-700"
                                   style="color: {{ block.settings.color_scheme.settings.secondary }};">
                                    {{ block.settings.created_at | escape }}
                                </p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% if section.settings.enable_navigation %}
                <div class="flex justify-center items-center gap-x-6 md:gap-x-14 py-2 mt-3 md:mt-6">
                    <div class="swiper-button-prev" style="color: {{ section.settings.nav_btn_color }};"></div>
                    <div class="swiper-pagination"></div>
                    <div class="swiper-button-next" style="color: {{ section.settings.nav_btn_color }};"></div>
                </div>
            {% endif %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-6"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.testimonials.settings.title.label",
      "default": "t:sections.testimonials.settings.title.default"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.testimonials.settings.description.label"
    },
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.header-1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_navigation",
      "label": "t:sections.testimonials.settings.enable_navigation.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:sections.testimonials.settings.enable_autoplay.label",
      "default": false
    },
    {
      "type": "color",
      "id": "nav_btn_color",
      "label": "t:sections.testimonials.settings.nav_btn_color.label",
      "default": "#217BAF"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "شهادة",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.color_scheme.label",
          "default": "scheme-4"
        },
        {
          "type": "checkbox",
          "id": "enable_customer_img",
          "label": "t:sections.testimonials.blocks.testimonial.settings.enable_customer_img.label",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "customer_img",
          "label": "t:sections.testimonials.blocks.testimonial.settings.customer_img.label"
        },
        {
          "type": "textarea",
          "id": "testimonial",
          "label": "t:sections.testimonials.blocks.testimonial.settings.testimonial.label",
          "default": "t:sections.testimonials.blocks.testimonial.settings.testimonial.default"
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "t:sections.testimonials.blocks.testimonial.settings.customer_name.label",
          "default": "t:sections.testimonials.blocks.testimonial.settings.customer_name.default"
        },
        {
          "type": "text",
          "id": "created_at",
          "label": "t:sections.testimonials.blocks.testimonial.settings.created_at.label",
          "default": "20/04/2024"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}

