{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_color = section.settings.color_scheme.settings.secondary %}
{% assign secondary_light_color = section.settings.color_scheme.settings.secondary_light %}
{% assign secondary_lighter_color = section.settings.color_scheme.settings.secondary_lighter %}
{% assign button_label = section.settings.color_scheme.settings.button_label %}
{% assign button_bg = section.settings.color_scheme.settings.button %}
{% assign border_color = section.settings.color_scheme.settings.button_border %}
{% assign secondary_button_label = section.settings.color_scheme.settings.secondary_button_label %}
{% assign secondary_button_bg = section.settings.color_scheme.settings.secondary_button %}
{% assign icons_color = section.settings.color_scheme.settings.icons %}
{% assign icons_bg = section.settings.color_scheme.settings.bg_icons %}

<style>
    .tag_btn {
        background-color: {{ secondary_button_bg }};
        color: {{ secondary_button_label }};
        border-color: {{ border_color }};
    }

    .tag_btn:hover {
        background-color: {{ button_bg }};
        color: {{ button_label }};
    }

    .article__content p {
        color: {{ secondary_light_color }};
    }

    .article__content h1,
    .article__content h2,
    .article__content h3,
    .article__content h4,
    .article__content h5,
    .article__content h6 {
        color: {{ primary_color }};
    }
</style>

<div class="bg-white px-2 md:px-6 py-6 md:py-8" style="background-color: {{ background }};">
    <!-- Breadcrumbs -->
    <div class="breadcrumbs flex items-center gap-2 page-width">
        <a href="{{ routes.root_url }}"
           class="text-xs md:text-base leading-normal font-normal text-black" style="color: {{ secondary_color }};">
            {{ 'general.breadcrumbs.home' | t }}
        </a>
        <span style="color: {{ secondary_color }};">
                {% render 'icon-chevron-left', classes: 'size-4 ltr:rotate-180' %}
            </span>
        <a href="{{ blog.url }}"
           class="text-xs md:text-base leading-normal font-normal text-black" style="color: {{ secondary_color }};">
            {{ 'general.breadcrumbs.blog' | t }}
        </a>
        <span style="color: {{ secondary_color }};">
            {% render 'icon-chevron-left', classes: 'size-4 ltr:rotate-180' %}
        </span>
        <span class="text-xs md:text-base leading-normal font-normal text-gray-500"
              style="color: {{ secondary_lighter_color }};">
            {{ article.title }}
        </span>
    </div>

    <!-- Article image -->
    <div class="mt-6 md:mt-8">
        <div class="w-full page-width">
            {% if article.image == blank %}
                <div class="relative aspect-w-4 aspect-h-4 md:aspect-w-16 md:aspect-h-7 overflow-hidden rounded-sm md:rounded-md">
                    <img src="{{ article.image | img_url: 'master' }}"
                         alt="{{ article.image.alt }}"
                         class="w-full h-full object-cover object-center"
                         loading="lazy"
                    >
                </div>
            {% else %}
                <div class="relative border border-gray-400 aspect-w-4 aspect-h-4 md:aspect-w-16 md:aspect-h-7 overflow-hidden rounded-sm md:rounded-md">
                    <img class="h-full w-full object-cover object-center"
                         src="{{ 'lifestyle-2.svg' | asset_url }}"
                         alt="lifestyle-2 placeholder image" loading="lazy"/>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- title, date, author, links -->
    <div class="py-6 md:py-8 md:px-16 lg:px-[5.75rem] page-width">
        <h1 class="text-base md:text-3xl font-medium leading-normal text-primary-main"
            style="color: {{ primary_color }};">
            {{ article.title }}
        </h1>

        {% if section.settings.show_date or section.settings.show_author or section.settings.show_share_links %}
            <div class="flex items-center justify-between mt-2.5 md:mt-4">
                <div class="flex items-center gap-1 md:gap-2">
                    {% if section.settings.show_date %}
                        <span class="text-[0.625rem]/3 md:text-xs/6 font-normal text-gray-500
                        {% if section.settings.show_author %}
                            border-e pe-1 md:pe-2
                        {% endif %}
                    " style="color: {{ secondary_lighter_color }};">
                        {{ article.published_at | date: "%d/%m/%Y" }}
                    </span>
                    {% endif %}

                    {% if section.settings.show_author %}
                        <span class="text-[0.625rem]/3 md:text-xs/6 font-normal text-gray-500"
                              style="color: {{ secondary_lighter_color }};">
                        {{ article.author }}
                    </span>
                    {% endif %}
                </div>

                {% if section.settings.show_share_links %}
                    {% assign article_url = shop.url | append: article.url %}
                    {% assign article_title = article.title | url_encode %}

                    <div class="flex flex-row-reverse md:flex-row items-center gap-2.5 md:gap-4">
                        {% if section.settings.facebook_link %}
                            <a href="https://www.facebook.com/sharer/sharer.php?u={{ article_url }}"
                               class="text-primary-main"
                               target="_blank" rel="noopener noreferrer" style="color: {{ primary_color }};">
                                {% render 'icon-facebook', classes: 'size-4 md:w-[20px] md:h-[21px]' %}
                            </a>
                        {% endif %}
                        {% if section.settings.x_link %}
                            <a href="https://twitter.com/intent/tweet?text={{ article_title }}&url={{ article_url }}"
                               class="text-primary-main" target="_blank" rel="noopener noreferrer"
                               style="color: {{ primary_color }};">
                                {% render 'icon-x', classes: 'size-3.5 md:w-[18px] md:h-[17px]' %}
                            </a>
                        {% endif %}
                        {% if section.settings.instagram_link %}
                            <a href="https://www.instagram.com/direct/new?url={{ article_url }}"
                               class="text-primary-main" target="_blank" rel="noopener noreferrer"
                               style="color: {{ primary_color }};">
                                {% render 'icon-instagram', classes: 'size-3.5 md:w-[18px] md:h-[19px]' %}
                            </a>
                        {% endif %}
                        {% if section.settings.linkedin_link %}
                            <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ article_url }}&title={{ article_title }}"
                               class="text-primary-main" target="_blank" rel="noopener noreferrer"
                               style="color: {{ primary_color }};">
                                {% render 'icon-linkedin', classes: 'size-4 md:w-[18px] md:h-[19px]' %}
                            </a>
                        {% endif %}
                        {% if section.settings.copy_link %}
                            <div class="flex" x-data="{
                                copied: false,
                                loading: false,
                                copyToClipboard(textContent) {
                                    this.loading = true;
                                    setTimeout(() => {
                                        navigator.clipboard.writeText(textContent)
                                        .then(() => {
                                            this.copied = true;
                                            setTimeout(() => this.copied = false, 2000);
                                        })
                                        .catch(error => {
                                            console.error('Failed to copy text: ', error);
                                        })
                                        .finally(() => {
                                            this.loading = false;
                                        });
                                    }, 300);
                                }
                            }">
                                <button x-cloak
                                        x-on:click.prevent="copyToClipboard('{{ article_url }}')"
                                        :disabled="loading"
                                        :class="loading ? 'opacity-50': 'opacity-100'"
                                        class="text-primary-main relative" style="color: {{ primary_color }};">
                                    <span x-show="!loading">
                                        {% render 'icon-link', classes: 'size-3.5 md:size-5' %}
                                    </span>

                                    <!-- Spinner, shown when loading -->
                                    <span x-show="loading" class="flex justify-center items-center">
                                        <svg class="animate-spin size-3.5 md:size-5" xmlns="http://www.w3.org/2000/svg"
                                             fill="none"
                                             viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                                    stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor"
                                                  d="M4 12a8 8 0 018-8v2a6 6 0 00-6 6H4z"></path>
                                        </svg>
                                    </span>

                                    <!-- Tooltip Feedback -->
                                    <span x-show="copied"
                                          class="absolute start-1/2 top-full transform -translate-x-1/2 rtl:translate-x-1/2 mt-2.5 md:mt-3.5 bg-primary-main text-white text-[6px] md:text-xs leading-loose rounded py-1 px-2 min-w-10 md:min-w-14"
                                          x-transition:enter="transition ease-out duration-300"
                                          x-transition:enter-start="opacity-0 transform scale-90"
                                          x-transition:enter-end="opacity-100 transform scale-100"
                                          x-transition:leave="transition ease-in duration-300"
                                          x-transition:leave-start="opacity-100 transform scale-100"
                                          x-transition:leave-end="opacity-0 transform scale-90"
                                          style="background-color: {{ icons_bg }}; color: {{ icons_color }};">
                                        {{ 'sections.featured_collection.url_copied' | t }}
                                        <!-- Arrow -->
                                        <div class="absolute start-1/2 rtl:start-auto rtl:end-1/2 top-0 transform -translate-y-1/2 -translate-x-1/2">
                                            <div class="w-1.5 h-1.5 md:w-2.5 md:h-2.5 bg-primary-main rotate-45"
                                                 style="background-color: {{ icons_bg }};"></div>
                                        </div>
                                    </span>
                                </button>
                            </div>
                        {% endif %}
                    </div>

                {% endif %}
            </div>
        {% endif %}
    </div>

    <div class="mb-6 md:mb-8">
        <hr class="bg-[#EEEEEE] bg-opacity-90 page-width" style="background-color: {{ border_color }};">
    </div>

    <!-- Content -->
    <div class="article__content md:px-16 lg:px-[5.75rem] page-width">
        {{ article.content }}
    </div>

    {% if article.tags.size > 0 %}
        <!-- Tags -->
        <div class="pt-5 md:pt-10 flex justify-center items-center flex-wrap gap-2 md:gap-5 page-width">
            {% for tag in article.tags %}
                {% assign translation_key = 'general.tags.' | append: tag | downcase | replace: ' ', '_' %}
                {% assign translated_tag = translation_key | t %}
                {% assign tag_handle = tag | handleize %}

                <a href="{{ blog.url }}/tagged/{{ tag_handle }}"
                   class="text-xs md:text-sm lg:text-base font-medium leading-normal text-primary-main border border-gray-200 px-5 py-2 md:px-8 md:py-2.5 rounded md:rounded-md hover:text-white hover:bg-primary-main transition duration-300 ease-in-out tag_btn">
                    {% if translated_tag contains 'Translation missing' %}
                        {{ tag }}
                    {% else %}
                        {{ translated_tag }}
                    {% endif %}
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% if blog.articles_count > 1 %}
    <div class="bg-white mx-auto ps-2 md:pe-2 py-6 md:py-8" data-page-type="article-slider"
         style="background-color: {{ background }};">
        <div class="flex justify-center items-center">
            <div class="w-full lg:max-w-xl flex flex-col justify-center items-center text-center gap-6 md:gap-4">
                <h2 class="text-xl md:text-3xl text-gray-900 font-medium"
                    style="color: {{ secondary_color }};">
                    {{ 'pages.blog.related_articles_title' | t }}
                </h2>

                <p class="text-sm/6 md:text-base/6 text-gray-500 font-normal"
                   style="color: {{ secondary_lighter_color }};">
                    {{ 'pages.blog.related_articles_description' | t }}
                </p>
            </div>
        </div>

        {% assign current_article_id = article.id %}
        {% assign max_articles = section.settings.number_of_articles_to_show %}
        {% assign displayed_articles = 0 %}

        <div class="mt-8 md:mt-12">
            <div id="swiper_{{ section.id }}"
                 class="swiper gap-2 page-width latest-articles__swiper !hidden"
                 data-autoplay="{{ section.settings.enable_autoplay }}">
                <div class="swiper-wrapper">
                    {% for article in blog.articles %}
                        {% if article.id != current_article_id %}
                            {% if displayed_articles < max_articles %}
                                {% render 'article-card',
                                        article: article,
                                        primary_color: secondary_color,
                                        secondary_color: secondary_light_color,
                                        secondary_light: secondary_lighter_color
                                %}

                                {% assign displayed_articles = displayed_articles | plus: 1 %}
                            {% else %}
                                {% break %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>

                {% if section.settings.enable_navigation %}
                    <div class="navigation__btns">
                        <div class="swiper-button-prev" style="color: {{ section.settings.nav_btn_color }};"></div>
                        <div class="swiper-button-next" style="color: {{ section.settings.nav_btn_color }};"></div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}

{% schema %}
{
  "name": "t:pages.article.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "default": true,
      "label": "t:pages.article.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:pages.article.settings.show_date.label"
    },
    {
      "type": "range",
      "id": "number_of_articles_to_show",
      "label": "t:pages.article.settings.number_of_articles_to_show.label",
      "info": "t:pages.article.settings.number_of_articles_to_show.info",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-10"
    },
    {
      "type": "header",
      "content": "t:pages.article.settings.header-1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_navigation",
      "label": "t:pages.article.settings.enable_navigation.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:pages.article.settings.enable_autoplay.label",
      "default": false
    },
    {
      "type": "color",
      "id": "nav_btn_color",
      "label": "t:pages.article.settings.nav_btn_color.label",
      "default": "#111827"
    },
    {
      "type": "header",
      "content": "t:pages.article.settings.header-2.content"
    },
    {
      "type": "checkbox",
      "id": "show_share_links",
      "default": true,
      "label": "t:pages.article.settings.show_share_links.label"
    },
    {
      "type": "checkbox",
      "id": "facebook_link",
      "default": true,
      "label": "t:pages.article.settings.facebook_link.label"
    },
    {
      "type": "checkbox",
      "id": "x_link",
      "default": true,
      "label": "t:pages.article.settings.x_link.label"
    },
    {
      "type": "checkbox",
      "id": "instagram_link",
      "default": false,
      "label": "t:pages.article.settings.instagram_link.label"
    },
    {
      "type": "checkbox",
      "id": "linkedin_link",
      "default": true,
      "label": "t:pages.article.settings.linkedin_link.label"
    },
    {
      "type": "checkbox",
      "id": "copy_link",
      "default": true,
      "label": "t:pages.article.settings.copy_link.label"
    }
  ]
}
{% endschema %}