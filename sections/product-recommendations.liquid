{% assign current_product_collection = product.collections.first %}
{% if current_product_collection.products.size > 1 %}
    <div class="bg-white px-2 md:px-6 py-6 md:py-8"
         style="background-color: {{ section.settings.color_scheme.settings.background }};">
        <div class="flex justify-center items-center">
            <div class="w-full lg:max-w-xl flex flex-col justify-center items-center text-center gap-6 md:gap-4">
                <h2 class="text-xl md:text-3xl text-gray-900 font-medium"
                    style="color: {{ section.settings.color_scheme.settings.text }};">
                    {{ section.settings.title }}
                </h2>
            </div>
        </div>

        {% assign max_products = section.settings.number_of_products_to_show %}
        {% assign displayed_products = 0 %}
        <div class="mt-8 md:mt-11">
            <div id="swiper_{{ section.id }}"
                 class="swiper gap-2 page-width product-recommendations__swiper !hidden"
                 data-autoplay="{{ section.settings.enable_autoplay }}">
                <div class="swiper-wrapper">
                    {% for product_in_collection in current_product_collection.products %}
                        {% if product_in_collection.handle != product.handle %}
                            {% if displayed_products < max_products %}
                                {% render 'product-card', product: product_in_collection %}

                                {% assign displayed_products = displayed_products | plus: 1 %}
                            {% else %}
                                {% break %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>

                {% if section.settings.enable_navigation %}
                    <div class="navigation__btns">
                        <div class="swiper-button-prev" style="color: {{ section.settings.nav_btn_color }};"></div>
                        <div class="swiper-button-next" style="color: {{ section.settings.nav_btn_color }};"></div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.product-recommendations.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.product-recommendations.settings.title.label",
      "default": "t:sections.product-recommendations.settings.title.default"
    },
    {
      "type": "range",
      "id": "number_of_products_to_show",
      "label": "t:sections.product-recommendations.settings.number_of_products_to_show.label",
      "min": 6,
      "max": 10,
      "step": 1,
      "default": 8
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "t:sections.product-recommendations.settings.header-1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_navigation",
      "label": "t:sections.product-recommendations.settings.enable_navigation.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:sections.product-recommendations.settings.enable_autoplay.label",
      "default": false
    },
    {
      "type": "color",
      "id": "nav_btn_color",
      "label": "t:sections.product-recommendations.settings.nav_btn_color.label",
      "default": "#111827"
    }
  ]
}
{% endschema %}