{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_color = section.settings.color_scheme.settings.secondary %}
{% assign secondary_light_color = section.settings.color_scheme.settings.secondary_light %}
{% assign border_color = section.settings.color_scheme.settings.button_border %}

<div class="bg-white px-2 md:px-6 py-6 md:py-8" style="background-color: {{ background }};">
    <!-- Breadcrumbs -->
    <div class="breadcrumbs flex items-center gap-2 page-width">
        <a href="{{ routes.root_url }}"
           class="text-xs md:text-base leading-normal font-normal text-black"
           style="color: {{ primary_color }};">
            {{ 'general.breadcrumbs.home' | t }}
        </a>
        <span style="color: {{ primary_color }};">
            {% render 'icon-chevron-left', classes: 'size-4 ltr:rotate-180' %}
        </span>
        <span class="text-xs md:text-base leading-normal font-normal text-gray-500"
              style="color: {{ secondary_light_color }};">
            {{ 'general.breadcrumbs.blog' | t }}
        </span>
    </div>

    {% if section.settings.enable_image %}
        <div class="mt-6 md:mt-8">
            <div class="w-full page-width">
                {% if section.settings.image != blank %}
                    <div class="relative aspect-w-4 aspect-h-4 md:aspect-w-16 md:aspect-h-7 overflow-hidden rounded-sm md:rounded-md">
                        <img src="{{ section.settings.image | img_url: 'master' }}"
                             alt="{{ section.settings.image.alt }}"
                             class="w-full h-full object-cover object-center"
                             loading="lazy"
                        >
                        <div class="flex justify-center items-center absolute inset-0">
                            <div class="p-3 flex flex-col justify-center items-center bg-black/30 h-40 w-full md:w-1/3 md:h-full">
                                <h1 class="text-3xl md:text-5xl font-medium leading-normal text-white">
                                    {{ 'pages.blog.title' | t }}
                                </h1>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="relative border border-gray-400 aspect-w-4 aspect-h-4 md:aspect-w-16 md:aspect-h-7 overflow-hidden rounded-sm md:rounded-md">
                        <img class="h-full w-full object-cover object-center"
                             src="{{ 'lifestyle-2.svg' | asset_url }}"
                             alt="lifestyle-2 placeholder image" loading="lazy"/>
                        
                        <div class="flex justify-center items-center absolute inset-0">
                            <div class="p-3 flex flex-col justify-center items-center bg-black/30 h-40 w-full md:w-1/3 md:h-full">
                                <h1 class="text-3xl md:text-5xl font-medium leading-normal text-white">
                                    {{ 'pages.blog.title' | t }}
                                </h1>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if blog.all_tags.size > 0 %}
        <div class="mt-5 md:mt-8">
            <div class="page-width flex justify-between items-center px-1 py-2.5 md:px-5 md:py-4 border border-gray-200 rounded md:rounded-md"
                 style="border-color: {{ border_color }};">
                <div class="flex relative"
                     x-data="{
                openTagsMenu: false,
                activeTag: 'all',
                init() {
                    const currentUrl = window.location.href;
                    if (currentUrl.includes('/tagged/')) {
                        const tagStart = currentUrl.indexOf('/tagged/') + '/tagged/'.length;
                        const tagEnd = currentUrl.indexOf('/', tagStart);
                        this.activeTag = currentUrl.substring(tagStart, tagEnd === -1 ? undefined : tagEnd);
                    }
                }
            }"
                >
                    <button class="inline-flex justify-center items-center gap-1 md:gap-3 text-sm md:text-base leading-normal font-normal text-gray-950"
                            x-on:click="openTagsMenu = true"
                            style="color: {{ primary_color }};"
                    >
                    <span>
                        {{ 'pages.blog.filter_by' | t }}
                    </span>
                        <span>
                        {% render 'icon-dropdown', classes: 'size-6 md:size-7' %}
                    </span>
                    </button>

                    <div x-cloak
                         x-show="openTagsMenu"
                         x-on:click.outside="openTagsMenu = false"
                         class="absolute top-9 md:top-12 -start-1 md:-start-5 z-10 mt-2 w-64 md:w-96 origin-top-right rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         style="background-color: {{ background }};"
                    >
                        <div class="py-3 px-2.5 md:py-6 md:px-5">
                            <h3 class="text-sm md:text-base font-normal leading-normal text-gray-950 pb-3 md:pb-4 border-b border-black border-opacity-10"
                                style="color: {{ primary_color }};">
                                {{ 'pages.blog.tags' | t }}
                            </h3>
                            <div class="mt-3 md:mt-4 space-y-3 md:space-y-5">
                                <a href="{{ blog.url }}"
                                   class="flex items-center cursor-pointer">
                            <span class="size-[1.125rem] md:size-6 flex justify-center items-center border border-gray-400 rounded md:rounded-md">
                                <span class="text-primary-main"
                                      :class="activeTag === 'all' ? 'inline-flex': 'hidden'"
                                >
                                    {% render 'icon-checkbox', classes: 'size-4 md:size-[1.125rem]' %}
                                </span>
                            </span>
                                    <span class="ms-2 text-sm md:text-base text-gray-900"
                                          style="color: {{ primary_color }};">
                                {{ 'pages.blog.all' | t }}
                            </span>
                                </a>

                                {% for tag in blog.all_tags %}
                                    {% assign translation_key = 'general.tags.' | append: tag | downcase | replace: ' ', '_' %}
                                    {% assign translated_tag = translation_key | t %}
                                    {% assign tag_handle = tag | handleize %}

                                    <a href="{{ blog.url }}/tagged/{{ tag_handle }}"
                                       class="flex items-center cursor-pointer">
                                    <span class="size-[1.125rem] md:size-6 flex justify-center items-center border border-gray-400 rounded md:rounded-md">
                                        <span class="text-primary-main"
                                              :class="activeTag === '{{ tag_handle }}' ? 'inline-flex': 'hidden'"
                                        >
                                            {% render 'icon-checkbox', classes: 'size-4 md:size-[1.125rem]' %}
                                        </span>
                                    </span>
                                        <span class="ms-2 text-sm md:text-base text-gray-900"
                                              style="color: {{ primary_color }};">
                                        {% if translated_tag contains 'Translation missing' %}
                                            {{ tag }}
                                        {% else %}
                                            {{ translated_tag }}
                                        {% endif %}
                                    </span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if blog.articles_count > 0 %}
        <div class="py-5 md:py-8 page-width">
            {% paginate blog.articles by section.settings.number_of_articles_per_page %}
                <div class="grid grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-5 lg:gap-x-3 lg:gap-y-7">
                    {% for article in blog.articles %}
                        {% render 'article-card',
                                article: article,
                                primary_color: primary_color,
                                secondary_color: secondary_color,
                                secondary_light: secondary_light_color
                        %}
                    {% endfor %}
                </div>

                {% render 'pagination', pagination: paginate %}
            {% endpaginate %}
        </div>
    {% else %}
        <!-- Blog empty -->
        <div class="py-6 flex justify-center items-center min-h-80 md:min-h-[30rem]">
            <div class="flex flex-col justify-center items-center gap-2.5 md:gap-4 text-center">
                <span class="text-primary-main">
                    {% render 'icon-blog', classes: 'size-7 md:size-8' %}
                </span>

                <p class="text-base md:text-xl leading-normal font-light text-gray-950"
                   style="color: {{ primary_color }};">
                    {{ 'pages.blog.empty_title' | t }}
                </p>
            </div>
        </div>
    {% endif %}
</div>

{% schema %}
{
  "name": "t:pages.blog.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_image",
      "default": true,
      "label": "t:pages.blog.settings.enable_image.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:pages.blog.settings.image.label"
    },
    {
      "type": "range",
      "id": "number_of_articles_per_page",
      "label": "t:pages.blog.settings.number_of_articles_per_page.label",
      "info": "t:pages.blog.settings.number_of_articles_per_page.info",
      "min": 6,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-6"
    }
  ]
}
{% endschema %}