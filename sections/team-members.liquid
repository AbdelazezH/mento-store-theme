<div class="bg-white px-2 md:px-6 py-6 md:py-8 lg:py-10"
     style="background-color: {{ section.settings.color_scheme.settings.background }};">
    <div class="flex justify-center items-center mb-6 md:mb-12">
        {% if section.settings.title != blank %}
            <h2 class="text-xl md:text-4xl font-normal leading-normal text-gray-900"
                style="color: {{ section.settings.color_scheme.settings.secondary }};">
                {{ section.settings.title }}
            </h2>
        {% endif %}
    </div>

    {% assign items_count = section.blocks.size %}

    {% if items_count > 0 %}
        {% if items_count <= 4 %}
            {% case items_count %}
                {% when 1 %}
                    {% assign grid_cols = 'grid-cols-4 md:grid-cols-8' %}
                {% when 2 %}
                    {% assign grid_cols = 'grid-cols-2 md:grid-cols-4' %}
                {% when 3 %}
                    {% assign grid_cols = 'grid-cols-4 md:grid-cols-8' %}
                {% else %}
                    {% assign grid_cols = 'grid-cols-2 md:grid-cols-4' %}
            {% endcase %}
            <div class="grid {{ grid_cols }} gap-6 md:gap-16 page-width">
                {% for block in section.blocks %}
                    {% if items_count == 1 %}
                        {% assign start_class = 'col-span-2 col-start-2 md:col-start-4' %}
                    {% elsif items_count == 2 %}
                        {% if forloop.index == 1 %}
                            {% assign start_class = 'md:col-start-2' %}
                        {% else %}
                            {% assign start_class = 'md:col-start-3' %}
                        {% endif %}
                    {% elsif items_count == 3 %}
                        {% if forloop.index == 1 %}
                            {% assign start_class = 'col-span-2 md:col-start-2' %}
                        {% elsif forloop.index == 2 %}
                            {% assign start_class = 'col-span-2 md:col-start-4' %}
                        {% else %}
                            {% assign start_class = 'col-span-2 col-start-2 md:col-start-6' %}
                        {% endif %}
                    {% else %}
                        {% assign start_class = '' %}
                    {% endif %}
                    <div class="{{ start_class }}">
                        {% render 'team-member', member: block.settings %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div id="swiper_{{ section.id }}"
                 class="swiper team-members__swiper page-width !hidden"
                 data-autoplay="{{ section.settings.enable_autoplay }}">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        {% render 'team-member', member: block.settings %}
                    {% endfor %}
                </div>

                {% if section.settings.enable_navigation %}
                    <div class="navigation__btns">
                        <div class="swiper-button-prev" style="color: {{ section.settings.nav_btn_color }};"></div>
                        <div class="swiper-button-next" style="color: {{ section.settings.nav_btn_color }};"></div>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
</div>

