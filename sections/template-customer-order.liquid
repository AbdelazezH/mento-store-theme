{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_color = section.settings.color_scheme.settings.secondary %}
{% assign secondary_light_color = section.settings.color_scheme.settings.secondary_light %}
{% assign secondary_lighter_color = section.settings.color_scheme.settings.secondary_lighter %}
{% assign button_label = section.settings.color_scheme.settings.button_label %}
{% assign button_bg = section.settings.color_scheme.settings.button %}
{% assign border_color = section.settings.color_scheme.settings.button_border %}
{% assign secondary_button_label = section.settings.color_scheme.settings.secondary_button_label %}
{% assign secondary_button_bg = section.settings.color_scheme.settings.secondary_button %}

<style>
    .order_text_hover:hover {
        color: {{ secondary_light_color }} !important;
    }

    .btn__track {
        background-color: {{ button_bg }};
        color: {{ button_label }};
        border-color: {{ border_color }};
    }

    .btn__track:hover {
        background-color: {{ secondary_button_bg }};
        color: {{ secondary_button_label }};
    }
</style>

<div class="bg-white px-2 md:px-6 py-6 md:py-8" style="background-color: {{ background }};">
    <!-- Breadcrumbs -->
    <div class="breadcrumbs flex items-center gap-2 page-width">
        <a href="{{ routes.root_url }}"
           class="text-xs md:text-base leading-normal font-normal text-black"
           style="color: {{ secondary_color }};">
            {{ 'general.breadcrumbs.home' | t }}
        </a>
        <span style="color: {{ secondary_color }};">
            {% render 'icon-chevron-left', classes: 'size-4 ltr:rotate-180' %}
        </span>
        <a href="{{ routes.account_url }}"
           class="text-xs md:text-base leading-normal font-normal text-black"
           style="color: {{ secondary_color }};">
            {{ 'general.header.my_orders' | t }}
        </a>
        <span style="color: {{ secondary_color }};">
            {% render 'icon-chevron-left', classes: 'size-4 ltr:rotate-180' %}
        </span>
        <span class="text-xs md:text-base leading-normal font-normal text-gray-500"
              style="color: {{ secondary_lighter_color }};">
            {{ 'general.breadcrumbs.order_details_page' | t }}
        </span>
    </div>

    <div class="my-5 md:my-8 lg:my-12">
        <div class="flex flex-col md:flex-row items-start md:justify-between gap-y-3 page-width">
            <div class="flex-1">
                <h1 class="text-xl md:text-3xl font-bold text-gray-900"
                    style="color: {{ secondary_color }};">
                    {{ 'customer.order_page.order_number' | t }}:
                    <span dir="ltr">
                    {{ order.name }}
                </span>
                </h1>
                <p class="text-xs md:text-base text-gray-700 my-2 md:my-3"
                   style="color: {{ secondary_light_color }};">
                <span class="text-gray-500" style="color: {{ secondary_lighter_color }};">
                    {{ 'customer.order_page.placed_on' | t }}:
                </span>
                    {{ order.created_at | date: format: 'abbreviated_date' }}
                </p>

                {% comment %} badge class colors for financial_status {% endcomment %}
                {% case order.financial_status %}
                    {% when 'paid' %}
                        {% assign financial_badge_class = 'bg-teal-100 text-teal-800' %}
                    {% when 'partially_paid' %}
                        {% assign financial_badge_class = 'bg-yellow-100 text-yellow-800' %}
                    {% when 'pending' %}
                        {% assign financial_badge_class = 'bg-orange-100 text-orange-800' %}
                    {% when 'refunded' %}
                        {% assign financial_badge_class = 'bg-blue-100 text-blue-800' %}
                    {% when 'voided' %}
                        {% assign financial_badge_class = 'bg-red-100 text-red-800' %}
                    {% else %}
                        {% assign financial_badge_class = 'bg-gray-100 text-gray-800' %}
                {% endcase %}

                <span class="inline-flex items-center gap-x-1.5 py-1 px-2 md:py-1.5 md:px-3 rounded-full text-[0.625rem] md:text-xs font-medium {{ financial_badge_class }}">
                {{ 'general.order_status.financial.' | append: order.financial_status | t }}
            </span>
            </div>

            <a href="{{ routes.account_url }}"
               class="inline-flex gap-x-2 md:gap-x-3 items-center text-xs md:text-base font-medium leading-normal text-gray-500 hover:text-gray-700 order_text_hover"
               style="color: {{ secondary_lighter_color }};">
                {{ 'customer.order_page.back_to_account' | t }}
                <span>
                {% render 'icon-arrow-long-left', classes: 'size-5 md:size-6 ltr:rotate-180' %}
            </span>
            </a>
        </div>
    </div>

    <div class="page-width">
        {% for line_item in order.line_items %}
            <div class="w-full border border-gray-200 divide-y rounded-sm mb-4"
                 style="border-color: {{ border_color }};">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-12 p-4 md:p-12">
                    <div class="w-full bg-gray-200 rounded-md overflow-hidden border aspect-w-4 aspect-h-4">
                        {% if line_item.image %}
                            <img class="w-full h-full object-cover object-center"
                                 src="{{ line_item.image | img_url: 'master' }}" alt="{{ item.title | escape }}"
                                 loading="lazy"
                            >
                        {% else %}
                            {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover object-center' }}
                        {% endif %}
                    </div>

                    <div class="md:py-4">
                        <h1 class="text-base md:text-xl text-gray-900 font-medium mb-4"
                            style="color: {{ secondary_color }};">
                            {{ line_item.product.title | link_to: line_item.product.url }}
                        </h1>

                        <table class="table-auto w-full mb-4">
                            <tbody>
                            <tr>
                                <td class="text-xs md:text-base border border-gray-200 text-gray-500 px-4 py-2"
                                    style="border-color: {{ border_color }}; color: {{ secondary_lighter_color }};">
                                    {{ 'customer.order_page.price' | t }}
                                </td>
                                <td class="text-xs md:text-base border border-gray-200 text-gray-700 px-4 py-2"
                                    style="border-color: {{ border_color }}; color: {{ secondary_light_color }};">
                                    {{ line_item.original_price | money }}
                                </td>
                            </tr>
                            <tr>
                                <td class="text-xs md:text-base border border-gray-200 text-gray-500 px-4 py-2"
                                    style="border-color: {{ border_color }}; color: {{ secondary_lighter_color }};">
                                    {{ 'customer.order_page.quantity' | t }}
                                </td>
                                <td class="text-xs md:text-base border border-gray-200 text-gray-700 px-4 py-2"
                                    style="border-color: {{ border_color }}; color: {{ secondary_light_color }};">
                                    {{ line_item.quantity }}
                                </td>
                            </tr>
                            <tr>
                                <td class="text-xs md:text-base border border-gray-200 text-gray-500 px-4 py-2"
                                    style="border-color: {{ border_color }}; color: {{ secondary_lighter_color }};">
                                    {{ 'customer.order_page.variants' | t }}
                                </td>
                                <td class="text-xs md:text-base border border-gray-200 text-gray-700 px-4 py-2"
                                    style="border-color: {{ border_color }}; color: {{ secondary_light_color }};">
                                    {% if line_item.variant.title != blank and line_item.variant.title != 'Default Title' %}
                                        {{ line_item.variant.title }}
                                    {% else %}
                                        {{ 'customer.order_page.no_variants' | t }}
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td class="text-xs md:text-base border border-gray-200 text-gray-500 px-4 py-2"
                                    style="border-color: {{ border_color }}; color: {{ secondary_lighter_color }};">
                                    {{ 'customer.order_page.total_price' | t }}
                                </td>
                                <td class="text-xs md:text-base border border-gray-200 text-gray-700 px-4 py-2"
                                    style="border-color: {{ border_color }}; color: {{ secondary_light_color }};">
                                    {{ line_item.final_line_price | money }}
                                </td>
                            </tr>
                            </tbody>
                        </table>

                        <div class="text-[11px] md:text-sm text-gray-500 line-clamp-2 mb-2 md:mb-4"
                             style="color: {{ secondary_lighter_color }};">
                            {{ line_item.product.description | truncatewords: 25 }}
                        </div>
                    </div>

                    <div class="md:py-4">
                        <h1 class="text-sm md:text-base font-medium text-gray-700 mb-4"
                            style="color: {{ secondary_light_color }};">
                            {{ 'customer.order_page.delivery_address' | t }}
                        </h1>

                        <div class="text-gray-500 mb-4">
                            <div>
                                <p class="text-[13px] md:text-base text-gray-700"
                                   style="color: {{ secondary_light_color }};">
                                    <span class="text-gray-500 me-2" style="color: {{ secondary_lighter_color }};">
                                        {{ 'customer.order_page.address1' | t }}:
                                    </span>
                                    {% if order.shipping_address.address1 != blank %}
                                        {{ order.shipping_address.address1 }}
                                    {% else %}
                                        {{ 'customer.order_page.undefined' | t }}
                                    {% endif %}
                                </p>
                                <p class="text-[13px] md:text-base text-gray-700"
                                   style="color: {{ secondary_light_color }};">
                                    <span class="text-gray-500 me-2" style="color: {{ secondary_lighter_color }};">
                                        {{ 'customer.order_page.address2' | t }}:
                                    </span>
                                    {% if order.shipping_address.address2 != blank %}
                                        {{ order.shipping_address.address2 }}
                                    {% else %}
                                        {{ 'customer.order_page.undefined' | t }}
                                    {% endif %}
                                </p>
                                <p class="text-[13px] md:text-base text-gray-700"
                                   style="color: {{ secondary_light_color }};">
                                    <span class="text-gray-500 me-2" style="color: {{ secondary_lighter_color }};">
                                        {{ 'customer.order_page.street' | t }}:
                                    </span>
                                    {% if order.shipping_address.street != blank %}
                                        {{ order.shipping_address.street }}
                                    {% else %}
                                        {{ 'customer.order_page.undefined' | t }}
                                    {% endif %}
                                </p>
                                <p class="text-[13px] md:text-base text-gray-700"
                                   style="color: {{ secondary_light_color }};">
                                    <span class="text-gray-500 me-2" style="color: {{ secondary_lighter_color }};">
                                        {{ 'customer.order_page.province' | t }}:
                                    </span>
                                    {% if order.shipping_address.province != blank %}
                                        {{ order.shipping_address.province }}
                                    {% else %}
                                        {{ 'customer.order_page.undefined' | t }}
                                    {% endif %}
                                </p>
                                <p class="text-[13px] md:text-base text-gray-700"
                                   style="color: {{ secondary_light_color }};">
                                    <span class="text-gray-500 me-2" style="color: {{ secondary_lighter_color }};">
                                        {{ 'customer.order_page.city' | t }}:
                                    </span>
                                    {% if order.shipping_address.city != blank %}
                                        {{ order.shipping_address.city }}
                                    {% else %}
                                        {{ 'customer.order_page.undefined' | t }}
                                    {% endif %}
                                </p>
                                <p class="text-[13px] md:text-base text-gray-700"
                                   style="color: {{ secondary_light_color }};">
                                    <span class="text-gray-500 me-2" style="color: {{ secondary_lighter_color }};">
                                        {{ 'customer.order_page.zip_code' | t }}:
                                    </span>
                                    {% if order.shipping_address.zip != blank %}
                                        {{ order.shipping_address.zip }}
                                    {% else %}
                                        {{ 'customer.order_page.undefined' | t }}
                                    {% endif %}
                                </p>
                                <p class="text-[13px] md:text-base text-gray-700"
                                   style="color: {{ secondary_light_color }};">
                                    <span class="text-gray-500 me-2" style="color: {{ secondary_lighter_color }};">
                                        {{ 'customer.order_page.country' | t }}:
                                    </span>
                                    {% if order.shipping_address.country != blank %}
                                        {{ order.shipping_address.country }}
                                    {% else %}
                                        {{ 'customer.order_page.undefined' | t }}
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-4 md:p-12">
                    <h1 class="text-base md:text-lg font-medium mb-4 text-gray-900"
                        style="color: {{ secondary_color }};">
                        {{ 'customer.order_page.fulfillment' | t }}
                    </h1>

                    {% if line_item.successfully_fulfilled_quantity > 0 %}
                        <p class="mb-2 text-[13px] md:text-base text-gray-700"
                           style="color: {{ secondary_light_color }};">
                            {{ 'customer.order_page.items_fulfilled' | t: count: line_item.successfully_fulfilled_quantity }}
                        </p>
                        <p class="mb-2 text-[13px] md:text-base text-gray-700"
                           style="color: {{ secondary_light_color }};">
                            <span class="text-gray-500 me-2" style="color: {{ secondary_lighter_color }};">
                                {{ 'customer.order_page.tracking_company' | t }}:
                            </span>
                            {{ line_item.fulfillment.tracking_company }}
                        </p>
                        <p class="mb-2 text-[13px] md:text-base text-gray-700"
                           style="color: {{ secondary_light_color }};">
                            <span class="text-gray-500 me-2" style="color: {{ secondary_lighter_color }};">
                                {{ 'customer.order_page.tracking_number' | t }}:
                            </span>
                            {{ line_item.fulfillment.tracking_number }}
                        </p>

                        <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank"
                           class="mt-4 flex items-center w-max text-xs md:text-sm text-white font-medium border bg-primary-main hover:bg-opacity-90 px-2.5 py-2 md:px-3 md:py-2.5 rounded btn__track">
                            <span>{{ 'customer.order_page.track_order' | t }}</span>
                            <span class="ms-1.5 md:ms-2">{% render 'icon-external-link', classes: 'size-4 md:size-5 rtl:-scale-x-100' %}</span>
                        </a>
                    {% else %}
                        <p class="text-xs md:text-base text-gray-500" style="color: {{ secondary_lighter_color }};">
                            {{ 'customer.order_page.text_not_fulfilled' | t }}
                        </p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="my-6">
        <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-12 border border-gray-200 rounded-sm p-4 md:p-12 page-width"
             style="border-color: {{ border_color }};">
            <div>
                <h1 class="text-base md:text-lg font-medium mb-4 text-primary-main"
                    style="color: {{ primary_color }};">
                    {{ 'customer.order_page.billing_address' | t }}
                </h1>
                <div class="text-sm md:text-base text-gray-700" style="color: {{ secondary_light_color }};">
                    {{ order.billing_address | format_address }}
                </div>
            </div>
            <div>
                <h1 class="text-base md:text-lg font-medium text-primary-main mb-4"
                    style="color: {{ primary_color }};">
                    {{ 'customer.order_page.payment_information' | t }}
                </h1>
                {% for transaction in order.transactions %}
                    {% assign credit_card_company = transaction.payment_details.credit_card_company %}
                    {% assign credit_card_last_four_digits = transaction.payment_details.credit_card_number %}

                    {% if credit_card_company %}
                        <p class="text-sm md:text-base" style="color: {{ secondary_color }};">
                            {{ credit_card_company }}
                        </p>
                        <p class="text-sm md:text-base" style="color: {{ secondary_color }};">
                            {{ credit_card_last_four_digits }}
                        </p>

                        {% case transaction.status_label %}
                            {% when 'Failure' %}
                                {% assign background = 'bg-red-700' %}
                            {% else %}
                                {% assign background = 'bg-green-700' %}

                        {% endcase %}

                        <span class="{{ background }} rounded-full text-white px-2.5 md:px-4 py-1 text-xs md:text-sm inline-block mb-2">
                        {{ 'customer.order_page.' | append: transaction.status_label | downcase | t }}
                    </span>
                    {% else %}
                        <p class="text-sm md:text-base text-gray-700 mb-4" style="color: {{ secondary_light_color }};">
                            {{ 'customer.order_page.order_manually_placed' | t }}
                            {{ shop.name }}
                        </p>
                    {% endif %}
                {% endfor %}
            </div>
            <div>
                <table class="table-auto w-full mb-4">
                    <tr>
                        <td class="text-sm md:text-base text-gray-500 border border-gray-200 px-4 py-2"
                            style="border-color: {{ border_color }}; color: {{ secondary_lighter_color }};">
                            {{ 'customer.order_page.subtotal_price' | t }}
                        </td>
                        <td class="text-sm md:text-base text-gray-700 border border-gray-200 px-4 py-2"
                            style="border-color: {{ border_color }}; color: {{ secondary_light_color }};">
                            {{ order.subtotal_price | money }}
                        </td>
                    </tr>
                    <tr>
                        <td class="text-sm md:text-base text-gray-500 border border-gray-200 px-4 py-2"
                            style="border-color: {{ border_color }}; color: {{ secondary_lighter_color }};">
                            {{ 'customer.order_page.shipping_price' | t }}
                        </td>
                        <td class="text-sm md:text-base text-gray-700 border border-gray-200 px-4 py-2"
                            style="border-color: {{ border_color }}; color: {{ secondary_light_color }};">
                            {{ order.shipping_price | money }}
                        </td>
                    </tr>
                    {% if order.tax_price %}
                        <tr>
                            <td class="text-sm md:text-base text-gray-500 border border-gray-200 px-4 py-2"
                                style="border-color: {{ border_color }}; color: {{ secondary_lighter_color }};">
                                {{ 'customer.order_page.tax_price' | t }}
                            </td>
                            <td class="text-sm md:text-base text-gray-700 border border-gray-200 px-4 py-2"
                                style="border-color: {{ border_color }}; color: {{ secondary_light_color }};">
                                {{ order.tax_price | money }}
                            </td>
                        </tr>
                    {% endif %}
                    <tr>
                        <td class="text-sm md:text-base text-gray-500 border border-gray-200 px-4 py-2"
                            style="border-color: {{ border_color }}; color: {{ secondary_lighter_color }};">
                            {{ 'customer.order_page.total_price' | t }}
                        </td>
                        <td class="text-sm md:text-base text-gray-700 border border-gray-200 px-4 py-2"
                            style="border-color: {{ border_color }}; color: {{ secondary_light_color }};">
                            {{ order.total_price | money }}
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "t:pages.order.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-10"
    }
  ]
}
{% endschema %}