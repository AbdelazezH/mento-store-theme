  "name": "t:sections.thumbnail-slider.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-11"
    },
    {
      "type": "checkbox",
      "id": "enable_navigation",
      "label": "t:sections.thumbnail-slider.settings.enable_navigation.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:sections.thumbnail-slider.settings.enable_autoplay.label",
      "default": true
    },
    {
      "type": "color",
      "id": "nav_btn_color",
      "label": "t:sections.thumbnail-slider.settings.nav_btn_color.label",
      "default": "#111827"
    }
  ],
  "blocks": [
    {
      "type": "thumbnail",
      "name": "t:sections.thumbnail-slider.blocks.thumbnail.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.thumbnail-slider.blocks.thumbnail.settings.image.label"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:sections.thumbnail-slider.blocks.thumbnail.settings.link_text.label",
          "default": "t:sections.thumbnail-slider.blocks.thumbnail.settings.link_text.default"
        },
