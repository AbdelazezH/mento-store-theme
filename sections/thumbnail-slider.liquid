{% if section.blocks.size > 0 %}
    <div class="bg-white mx-auto md:px-2 py-6 md:py-8"
         style="background-color: {{ section.settings.color_scheme.settings.background }};">

        <!-- for customizer preview -->
        <div class="thumbnail__preview page-width">
            <div class="hidden md:flex justify-center items-center gap-5">
                {% for block in section.blocks limit: 4 %}
                    {% render 'thumbnail-slide', thumbnail: block.settings %}
                {% endfor %}
            </div>

            <div class="flex md:hidden justify-center items-center gap-2">
                {% for block in section.blocks limit: 2 %}
                    {% render 'thumbnail-slide', thumbnail: block.settings %}
                {% endfor %}
            </div>
        </div>

        <div class="flex justify-center items-center page-width">
            <div id="swiper_{{ section.id }}"
                 class="swiper gap-2 thumbnail__swiper !hidden"
                 data-autoplay="{{ section.settings.enable_autoplay }}">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        <div class="swiper-slide relative max-w-48 md:max-w-full">
                            {% render 'thumbnail-slide', thumbnail: block.settings %}
                        </div>
                    {% endfor %}
                </div>
                {% if section.settings.enable_navigation %}
                    <div class="navigation__btns">
                        <div class="swiper-button-prev" style="color: {{ section.settings.nav_btn_color }};"></div>
                        <div class="swiper-button-next" style="color: {{ section.settings.nav_btn_color }};"></div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}

{% schema %}
