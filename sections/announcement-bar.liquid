<div class="bg-white">
    <div class="mx-auto justify-start">
        {% if section.settings.show_announcement %}
            <!-- Announcement Bar part -->
            {% assign background = section.settings.color_scheme.settings.background %}
            {% assign text_color = section.settings.color_scheme.settings.text %}
            <div class="announcement-bar px-2 md:px-6 py-4 bg-primary-light"
                 style="background-color: {{ background }};">
                <div class="page-width flex {{ section.settings.announcement_text_align }} items-center">
                    <a href="{{ section.settings.announcement_link }}" class="announcement-wrapper text-base/[22px] text-white font-normal"
                         style="color: {{ text_color }};">
                        {{ section.settings.announcement_text }}
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "default": true,
      "label": "t:sections.announcement-bar.settings.show_announcement.label"
    },
    {
      "type": "textarea",
      "id": "announcement_text",
      "default": "هنا مساحة لمثال محتوى اعلاني افتراضي يمكن استبداله",
      "label": "t:sections.announcement-bar.settings.announcement_text.label"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "t:sections.announcement-bar.settings.announcement_link.label",
      "default": "/collections/all"
    },
    {
      "type": "select",
      "id": "announcement_text_align",
      "label": "t:sections.announcement-bar.settings.announcement_text_align.label",
      "default": "justify-center",
      "options": [
        {
          "value": "justify-right",
          "label": "t:sections.announcement-bar.settings.announcement_text_align.options.justify-right.label"
        },
        {
          "value": "justify-center",
          "label": "t:sections.announcement-bar.settings.announcement_text_align.options.justify-center.label"
        },
        {
          "value": "justify-left",
          "label": "t:sections.announcement-bar.settings.announcement_text_align.options.justify-left.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.name"
    }
  ]
}
{% endschema %}