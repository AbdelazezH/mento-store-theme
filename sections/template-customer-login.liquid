{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_color = section.settings.color_scheme.settings.secondary %}
{% assign secondary_light_color = section.settings.color_scheme.settings.secondary_light %}
{% assign secondary_lighter_color = section.settings.color_scheme.settings.secondary_lighter %}
{% assign button_label = section.settings.color_scheme.settings.button_label %}
{% assign button_bg = section.settings.color_scheme.settings.button %}
{% assign border_color = section.settings.color_scheme.settings.button_border %}
{% assign secondary_button_label = section.settings.color_scheme.settings.secondary_button_label %}
{% assign secondary_button_bg = section.settings.color_scheme.settings.secondary_button %}

<style>
    .login_placeholder_color::placeholder {
        color: {{ secondary_lighter_color }} !important;
    }

    .btn__submit {
        background-color: {{ button_bg }};
        color: {{ button_label }};
        border-color: {{ border_color }};
    }

    .btn__submit:hover {
        background-color: {{ secondary_button_bg }};
        color: {{ secondary_button_label }};
    }

    .recover__submit_btn {
        background-color: {{ button_bg }};
        color: {{ button_label }};
        border-color: {{ border_color }};
    }

    .recover__submit_btn:hover {
        opacity: 0.8;
    }

    .recover__cancel_btn {
        background-color: {{ secondary_button_bg }};
        color: {{ secondary_button_label }};
    }

    .recover__cancel_btn:hover {
        background-color: {{ button_bg }};
        color: {{ button_label }};
        border-color: {{ border_color }};
    }
</style>

<div class="bg-white mx-auto" style="background-color: {{ background }};">
    <div class="flex items-center justify-center px-2 md:px-8 pt-8 pb-12 md:pt-16 md:pb-16"
         x-data="{ loginForm: $persist(true) }">
        <div x-cloak
             x-show="loginForm"
             class="max-w-lg w-full flex flex-col gap-6 md:gap-14">
            <div class="flex flex-col justify-center items-center gap-5 md:gap-6 text-center">
                <h1 class="text-2xl/snug md:text-3xl/snug font-normal md:font-medium text-primary-main"
                    style="color: {{ primary_color }};">
                    {{ 'customer.login.heading' | t }}
                </h1>

                <p class="text-base/snug font-normal text-gray-900"
                   style="color: {{ secondary_color }};">
                    {{ 'customer.login.sub' | t }}
                </p>
            </div>

            <div class="flex flex-col gap-6 md:gap-20">
                {% form 'customer_login', class: 'flex flex-col' %}
                    {% if form.errors %}
                        {% render 'alert', type: 'error', text: 'customer.login.error' %}
                    {% endif %}

                    <div class="my-2.5">
                        <label for="email_address" class="block text-base mb-3.5" style="color: {{ secondary_color }};">
                            {{ 'customer.login.email' | t }} <span class="text-red-600">*</span>
                        </label>

                        <input type="email" id="email_address" name="customer[email]" autocomplete="email"
                               placeholder="{{ 'customer.login.email' | t }}" required
                               class="relative block w-full text-base font-normal bg-transparent placeholder:text-gray-500 placeholder:text-base px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main login_placeholder_color"
                               style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                    </div>

                    {% if form.password_needed %}
                        <div class="my-2.5">
                            <label for="password" class="block text-base mb-3.5" style="color: {{ secondary_color }};">
                                {{ 'customer.login.password' | t }} <span class="text-red-600">*</span>
                            </label>
                            <input type="password" id="password" name="customer[password]"
                                   autocomplete="current-password" required
                                   placeholder="{{ 'customer.login.password' | t }}"
                                   class="relative block w-full text-base font-normal bg-transparent placeholder:text-gray-500 placeholder:text-base px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main login_placeholder_color"
                                   style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                        </div>

                        <div class="my-2">
                            <a href="#" x-on:click.prevent="loginForm = false;"
                               class="text-gray-700" style="color: {{ secondary_light_color }};">
                                {{ 'customer.login.forget_password' | t }}
                            </a>
                        </div>
                    {% endif %}

                    <div class="my-6 md:my-10">
                        <button type="submit"
                                class="relative block w-full text-base font-normal border text-white bg-primary-main hover:bg-opacity-90 py-3 btn__submit">
                            {{ 'customer.login.submit_btn' | t }}
                        </button>
                    </div>
                {% endform %}


                <div class="flex flex-col gap-5 text-center md:text-start">
                    <hr class="bg-gray-200" style="background-color: {{ border_color }};">
                    <a href="{{ routes.account_register_url }}" class="text-base font-normal text-gray-700"
                       style="color: {{ secondary_light_color }};">
                        {{ 'customer.login.new_user' | t }}
                    </a>
                </div>
            </div>
        </div>

        <div x-cloak
             x-show="!loginForm"
             class="max-w-lg w-full flex flex-col gap-6 md:gap-14 pb-6 md:pb-0">
            <div class="flex flex-col justify-center items-center gap-5 md:gap-6 text-center">
                <h1 class="text-2xl/snug md:text-3xl/snug font-normal md:font-medium text-primary-main"
                    style="color: {{ primary_color }};">
                    {{ 'customer.recover_password.heading' | t }}
                </h1>

                <p class="text-base/snug font-normal text-gray-900"
                   style="color: {{ secondary_color }};">
                    {{ 'customer.recover_password.sub' | t }}
                </p>
            </div>

            {% form 'recover_customer_password', class: 'flex flex-col' %}

                {% if form.errors %}
                    {% render 'alert', type: 'error', text: 'customer.recover_password.email_error' %}
                {% elsif form.posted_successfully? %}
                    <div x-data="{ showInstructions: false }"
                         x-init="setTimeout(() => showInstructions = true, 1000)">
                        <div x-cloak
                             x-transition:enter="transition ease-in-out duration-1000"
                             x-transition:enter-start="opacity-0 -translate-y-full"
                             x-transition:enter-end="opacity-100 translate-y-0"
                             x-transition:leave="transition ease-in-out duration-1000"
                             x-transition:leave-start="opacity-100 translate-y-0"
                             x-transition:leave-end="opacity-0 -translate-y-full"
                             x-show="showInstructions"
                             class="relative border border-primary-main rounded sm:rounded-md bg-secondary-light mb-2.5"
                             style="background-color: {{ background }}; border-color: {{ primary_color }};">
                            <div class="p-5">
                                <div class="flex flex-row items-center w-full my-3">
                                    <div class="text-primary-main font-medium" style="color: {{ primary_color }};">
                                        {% render 'icon-megaphone', classes: 'size-6 rtl:-scale-x-100' %}
                                    </div>

                                    <div class="text-base text-primary-main font-medium ms-3"
                                         style="color: {{ primary_color }};">
                                        {{ 'customer.recover_password.check_email' | t }}
                                    </div>
                                </div>

                                <ul class="flex flex-col gap-1.5 px-4 mb-3 ms-7 list-disc text-sm md:text-base text-gray-700"
                                    style="color: {{ secondary_light_color }};">
                                    <li><span>{{ 'customer.recover_password.check_email_1' | t }}</span></li>
                                    <li><span>{{ 'customer.recover_password.check_email_2' | t }}</span></li>
                                    <li><span>{{ 'customer.recover_password.check_email_3' | t }}</span></li>
                                </ul>
                            </div>

                            <button type="button" x-on:click="showInstructions = false;"
                                    class="absolute top-3 end-3 text-primary-main hover:bg-opacity-90 hover:shadow-md border rounded-full"
                                    style="color: {{ primary_color }};">
                                {% render 'icon-close', classes: 'size-5 sm:size-8' %}
                            </button>
                        </div>
                    </div>
                {% endif %}

                <div class="my-2.5">
                    <label for="email" class="block text-base mb-3.5" style="color: {{ secondary_color }};">
                        {{ 'customer.recover_password.email' | t }} <span class="text-red-600">*</span>
                    </label>

                    <input type="email" id="email" name="email" autocomplete="email"
                           placeholder="{{ 'customer.recover_password.email' | t }}" required
                           class="relative block w-full text-base font-normal bg-transparent placeholder:text-gray-500 placeholder:text-base px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main login_placeholder_color"
                           style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                </div>


                <div class="mt-7 flex flex-col gap-4 items-center text-center">
                    <button type="submit"
                            class="relative block w-full text-base font-normal text-white border bg-primary-main hover:bg-opacity-90 px-6 py-3 recover__submit_btn">
                        {{ 'customer.recover_password.submit_btn' | t }}
                    </button>

                    <a href="#" x-on:click.prevent="loginForm = true"
                       class="relative block w-full text-base font-normal text-gray-900 hover:border bg-white hover:bg-gray-50 hover:bg-opacity-90 px-6 py-3 recover__cancel_btn">
                        {{ 'customer.recover_password.cancel_btn' | t }}
                    </a>
                </div>

            {% endform %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "t:pages.login.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-10"
    }
  ]
}
{% endschema %}