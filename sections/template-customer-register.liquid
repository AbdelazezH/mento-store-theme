{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_color = section.settings.color_scheme.settings.secondary %}
{% assign secondary_light_color = section.settings.color_scheme.settings.secondary_light %}
{% assign secondary_lighter_color = section.settings.color_scheme.settings.secondary_lighter %}
{% assign button_label = section.settings.color_scheme.settings.button_label %}
{% assign button_bg = section.settings.color_scheme.settings.button %}
{% assign border_color = section.settings.color_scheme.settings.button_border %}
{% assign secondary_button_label = section.settings.color_scheme.settings.secondary_button_label %}
{% assign secondary_button_bg = section.settings.color_scheme.settings.secondary_button %}

<style>
    .register_placeholder_color::placeholder {
        color: {{ secondary_lighter_color }} !important;
    }

    .btn__submit {
        background-color: {{ button_bg }};
        color: {{ button_label }};
        border-color: {{ border_color }};
    }

    .btn__submit:hover {
        background-color: {{ secondary_button_bg }};
        color: {{ secondary_button_label }};
    }
</style>

<div class="bg-white mx-auto" style="background-color: {{ background }};">
    <div class="flex items-center justify-center px-2 md:px-8 pt-8 pb-12 md:pt-16 md:pb-16">
        <div class="max-w-xl w-full flex flex-col gap-6 md:gap-14">
            <div class="max-w-sm self-center flex flex-col justify-center items-center gap-5 md:gap-6 text-center">
                <h1 class="text-2xl/snug md:text-3xl/snug font-normal md:font-medium text-primary-main"
                    style="color: {{ primary_color }};">
                    {{ 'customer.register.heading' | t }}
                </h1>

                <p class="text-base/snug font-normal text-gray-900"
                   style="color: {{ secondary_color }};">
                    {{ 'customer.register.sub' | t }}
                </p>
            </div>

            <div class="flex flex-col gap-6">
                {% form 'create_customer', class: 'flex flex-col' %}

                    {% if form.errors %}
                        {% render 'alert', type: 'error', text: 'customer.register.error' %}
                    {% endif %}

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-0 md:gap-6">
                        <div class="my-2.5">
                            <label for="first_name" class="block text-base mb-3.5"
                                   style="color: {{ secondary_color }};">
                                {{ 'customer.register.first_name' | t }} <span class="text-red-600">*</span>
                            </label>

                            <input type="text" id="first_name" name="customer[first_name]" autocomplete="given-name"
                                   placeholder="{{ 'customer.register.first_name' | t }}" required
                                   class="relative block w-full text-base font-normal bg-transparent placeholder:text-gray-500 placeholder:text-base px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main register_placeholder_color"
                                   style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                        </div>

                        <div class="my-2.5">
                            <label for="last_name" class="block text-base mb-3.5" style="color: {{ secondary_color }};">
                                {{ 'customer.register.last_name' | t }} <span class="text-red-600">*</span>
                            </label>

                            <input type="text" id="last_name" name="customer[last_name]" autocomplete="family-name"
                                   placeholder="{{ 'customer.register.last_name' | t }}" required
                                   class="relative block w-full text-base font-normal bg-transparent placeholder:text-gray-500 placeholder:text-base px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main register_placeholder_color"
                                   style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                        </div>
                    </div>

                    <div class="my-2.5">
                        <label for="email_address" class="block text-base mb-3.5" style="color: {{ secondary_color }};">
                            {{ 'customer.register.email' | t }} <span class="text-red-600">*</span>
                        </label>

                        <input type="email" id="email_address" name="customer[email]" autocomplete="email"
                               placeholder="{{ 'customer.register.email' | t }}" required
                               class="relative block w-full text-base font-normal bg-transparent placeholder:text-gray-500 placeholder:text-base px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main register_placeholder_color"
                               style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                    </div>

                    <div class="my-2.5">
                        <label for="password" class="block text-base mb-3.5" style="color: {{ secondary_color }};">
                            {{ 'customer.register.password' | t }} <span class="text-red-600">*</span>
                        </label>
                        <input type="password" id="password" name="customer[password]"
                               autocomplete="new-password" required
                               placeholder="{{ 'customer.register.password' | t }}"
                               class="relative block w-full text-base font-normal bg-transparent placeholder:text-gray-500 placeholder:text-base px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main register_placeholder_color"
                               style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                    </div>

                    <div class="mt-6 md:mt-10">
                        <button type="submit"
                                class="relative block w-full text-base font-normal text-white bg-primary-main border hover:bg-opacity-90 py-3 btn__submit">
                            {{ 'customer.register.submit_btn' | t }}
                        </button>
                    </div>

                {% endform %}

                <div class="flex flex-col gap-6 text-center md:text-start">
                    <hr class="bg-gray-200" style="background-color: {{ border_color }};">
                    <a href="{{ routes.account_login_url }}" class="text-base font-normal text-gray-700"
                       style="color: {{ secondary_light_color }};">
                        {{ 'customer.register.not_new_user' | t }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "t:pages.register.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-10"
    }
  ]
}
{% endschema %}