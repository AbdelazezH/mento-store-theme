{% assign background = section.settings.color_scheme.settings.background %}
{% assign primary_color = section.settings.color_scheme.settings.text %}
{% assign secondary_color = section.settings.color_scheme.settings.secondary %}
{% assign secondary_lighter_color = section.settings.color_scheme.settings.secondary_lighter %}
{% assign button_label = section.settings.color_scheme.settings.button_label %}
{% assign button_bg = section.settings.color_scheme.settings.button %}
{% assign border_color = section.settings.color_scheme.settings.button_border %}
{% assign secondary_button_label = section.settings.color_scheme.settings.secondary_button_label %}
{% assign secondary_button_bg = section.settings.color_scheme.settings.secondary_button %}

<style>
    .reset_placeholder_color::placeholder {
        color: {{ secondary_lighter_color }} !important;
    }

    .btn__submit {
        background-color: {{ button_bg }};
        color: {{ button_label }};
        border-color: {{ border_color }};
    }

    .btn__submit:hover {
        background-color: {{ secondary_button_bg }};
        color: {{ secondary_button_label }};
    }
</style>


<div class="bg-white mx-auto" style="background-color: {{ background }};">
    <div class="flex items-center justify-center px-2 md:px-8 pt-8 pb-12 md:pt-16 md:pb-16">
        <div class="max-w-lg w-full flex flex-col gap-6 md:gap-14 pb-6 md:pb-0">
            <div class="flex flex-col justify-center items-center gap-5 md:gap-6 text-center">
                <h1 class="text-2xl/snug md:text-3xl/snug font-normal md:font-medium text-primary-main"
                    style="color: {{ primary_color }};">
                    {{ 'customer.reset_password.heading' | t }}
                </h1>

                <p class="text-base/snug font-normal text-gray-900"
                   style="color: {{ secondary_color }};">
                    {{ 'customer.reset_password.sub' | t }}
                </p>
            </div>

            {% form 'reset_customer_password', class: 'flex flex-col' %}
                {% if form.errors %}
                    {% render 'alert', type: 'error', text: 'customer.reset_password.error' %}
                {% endif %}

                <div class="my-2.5">
                    <label for="password" class="block text-base mb-3.5"
                           style="color: {{ secondary_color }};">
                        {{ 'customer.reset_password.password' | t }} <span class="text-red-600">*</span>
                    </label>
                    <input type="password" id="password" name="customer[password]"
                           autocomplete="new-password" required
                           placeholder="{{ 'customer.reset_password.password' | t }}"
                           class="relative block w-full text-base font-normal bg-transparent placeholder:text-gray-500 placeholder:text-base px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main reset_placeholder_color"
                           style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                </div>

                <div class="my-2.5">
                    <label for="password_confirmation" class="block text-base mb-3.5"
                           style="color: {{ secondary_color }};">
                        {{ 'customer.reset_password.password_confirmation' | t }} <span class="text-red-600">*</span>
                    </label>
                    <input type="password" id="password_confirmation" name="customer[password_confirmation]"
                           autocomplete="new-password" required
                           placeholder="{{ 'customer.reset_password.password_confirmation' | t }}"
                           class="relative block w-full text-base font-normal bg-transparent placeholder:text-gray-500 placeholder:text-base px-6 py-3 border focus:outline-none focus:ring-2 focus:ring-primary-main reset_placeholder_color"
                           style="color: {{ secondary_color }}; border-color: {{ border_color }};">
                </div>

                <div class="mt-7 flex flex-col gap-4 items-center text-center">
                    <button type="submit"
                            class="relative block w-full text-base border font-normal text-white bg-primary-main hover:bg-opacity-90 px-6 py-3 btn__submit">
                        {{ 'customer.reset_password.submit_btn' | t }}
                    </button>
                </div>
            {% endform %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "t:pages.reset-password.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-10"
    }
  ]
}
{% endschema %}