<section class="bg-white mx-auto ps-2 md:pe-2 py-6 md:py-8"
         style="background-color: {{ section.settings.color_scheme.settings.background }};">
    <div class="flex justify-center items-center">
        <div class="w-full lg:max-w-xl flex flex-col justify-center items-center text-center gap-6 md:gap-4">
            <h2 class="text-xl md:text-3xl text-gray-900 font-medium"
                style="color: {{ section.settings.color_scheme.settings.text }};">
                {{ section.settings.title }}
            </h2>

            {% if section.settings.description != blank %}
                <p class="text-sm/6 md:text-base/6 text-gray-500 font-normal"
                   style="color: {{ section.settings.color_scheme.settings.secondary_light }};">
                    {{ section.settings.description }}
                </p>
            {% endif %}
        </div>
    </div>

    <div class="mt-8 md:mt-12">

        <!-- for customizer preview -->
        <div class="latest-articles__preview page-width">
            <div class="hidden md:grid grid-cols-3 gap-3">
                {% for i in (1..3) %}
                    {% render 'article-card-placeholder' %}
                {% endfor %}
            </div>

            <div class="grid md:hidden grid-cols-2 gap-1">
                {% for i in (1..2) %}
                    {% render 'article-card-placeholder' %}
                {% endfor %}
            </div>
        </div>

        <div id="swiper_{{ section.id }}"
             class="swiper gap-2 page-width latest-articles__swiper !hidden"
             data-autoplay="{{ section.settings.enable_autoplay }}">
            <div class="swiper-wrapper">
                {% for article in section.settings.blog.articles limit: section.settings.number_of_articles_to_show %}
                    {% render 'article-card',
                            article: article,
                            primary_color: section.settings.color_scheme.settings.text,
                            secondary_color: section.settings.color_scheme.settings.secondary,
                            secondary_light: section.settings.color_scheme.settings.secondary_light
                    %}
                {% else %}
                    {% for i in (1..section.settings.number_of_articles_to_show) %}
                        {% render 'article-card-placeholder' %}
                    {% endfor %}
                {% endfor %}
            </div>

            {% if section.settings.enable_navigation %}
                <div class="navigation__btns">
                    <div class="swiper-button-prev" style="color: {{ section.settings.nav_btn_color }};"></div>
                    <div class="swiper-button-next" style="color: {{ section.settings.nav_btn_color }};"></div>
                </div>
            {% endif %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "t:sections.featured-articles.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.featured-articles.settings.title.label",
      "default": "t:sections.featured-articles.settings.title.default"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.featured-articles.settings.description.label"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured-articles.settings.blog.label"
    },
    {
      "type": "range",
      "id": "number_of_articles_to_show",
      "label": "t:sections.featured-articles.settings.number_of_articles_to_show.label",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "t:sections.featured-articles.settings.header-1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_navigation",
      "label": "t:sections.featured-articles.settings.enable_navigation.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:sections.featured-articles.settings.enable_autoplay.label",
      "default": false
    },
    {
      "type": "color",
      "id": "nav_btn_color",
      "label": "t:sections.featured-articles.settings.nav_btn_color.label",
      "default": "#111827"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-articles.name"
    }
  ]
}
{% endschema %}