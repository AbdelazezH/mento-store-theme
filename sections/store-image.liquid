{% assign background = section.settings.color_scheme.settings.background %}

<div class="bg-white px-2 md:px-6 py-6 md:py-8" style="background-color: {{ background }};">
    <div class="w-full page-width">
        {% if section.settings.image != blank %}
            <div class="relative aspect-w-4 aspect-h-4 md:aspect-w-16 md:aspect-h-7 overflow-hidden rounded-sm md:rounded-md">
                <img src="{{ section.settings.image | img_url: 'master' }}"
                     alt="{{ section.settings.image.alt }}"
                     class="w-full h-full object-cover object-center"
                     loading="lazy"
                >
                {% if section.settings.enable_shadow %}
                    <div class="flex justify-center items-center absolute inset-0">
                        <div class="p-3 flex flex-col justify-center items-center bg-black/30 h-40 w-full md:w-1/3 md:h-full">
                            {% if section.settings.title != blank %}
                                <h1 class="text-3xl md:text-5xl font-medium leading-normal text-white text-center">
                                    {{ section.settings.title }}
                                </h1>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        {% else %}
            <div class="relative border border-gray-400 aspect-w-4 aspect-h-4 md:aspect-w-16 md:aspect-h-7 overflow-hidden rounded-sm md:rounded-md">
                <img class="h-full w-full object-cover object-center"
                     src="{{ 'lifestyle-2.svg' | asset_url }}"
                     alt="lifestyle-2 placeholder image" loading="lazy"/>
                {% if section.settings.enable_shadow %}
                    <div class="flex justify-center items-center absolute inset-0">
                        <div class="p-3 flex flex-col justify-center items-center bg-black/30 h-40 w-full md:w-1/3 md:h-full">
                            {% if section.settings.title != blank %}
                                <h1 class="text-3xl md:text-5xl font-medium leading-normal text-white text-center">
                                    {{ section.settings.title }}
                                </h1>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>

{% schema %}
{
  "name": "t:sections.store-image.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.store-image.settings.image.label"
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "default": true,
      "label": "t:sections.store-image.settings.enable_shadow.label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.store-image.settings.title.label",
      "default": "t:sections.store-image.settings.title.default",
      "info": "t:sections.store-image.settings.title.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-6"
    }
  ],
  "presets": [
    {
      "name": "t:sections.store-image.name"
    }
  ]
}
{% endschema %}