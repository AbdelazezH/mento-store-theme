<div class="bg-secondary-light px-2 md:px-6 py-6 md:py-8 lg:py-12"
     style="background-color: {{ section.settings.color_scheme.settings.background }};">
    <div class="flex items-center justify-center mb-10 md:mb-12">
        {% if section.settings.title != blank %}
            <h2 class="text-xl md:text-4xl font-normal leading-normal text-gray-900"
                style="color: {{ section.settings.color_scheme.settings.secondary }};">
                {{ section.settings.title }}
            </h2>
        {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
        {% if section.blocks.size <= 4 %}
            <div class="flex flex-col md:flex-row items-center justify-center md:flex-wrap gap-16 md:gap-44 page-width">
                {% for block in section.blocks %}
                    {% render 'store-stat', stat: block.settings %}
                {% endfor %}
            </div>
        {% else %}
            <div id="swiper_{{ section.id }}"
                 class="swiper store-statistics__swiper page-width !hidden"
                 data-autoplay="{{ section.settings.enable_autoplay }}">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        <div class="swiper-slide">
                            {% render 'store-stat', stat: block.settings %}
                        </div>
                    {% endfor %}
                </div>

                {% if section.settings.enable_navigation %}
                    <div class="navigation__btns">
                        <div class="swiper-button-prev" style="color: {{ section.settings.nav_btn_color }};"></div>
                        <div class="swiper-button-next" style="color: {{ section.settings.nav_btn_color }};"></div>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
</div>

{% schema %}
{
  "name": "t:sections.store-statistics.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.store-statistics.settings.title.label",
      "default": "t:sections.store-statistics.settings.title.default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-9"
    },
    {
      "type": "header",
      "content": "t:sections.store-statistics.settings.header-1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_navigation",
      "label": "t:sections.store-statistics.settings.enable_navigation.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:sections.store-statistics.settings.enable_autoplay.label",
      "default": false
    },
    {
      "type": "color",
      "id": "nav_btn_color",
      "label": "t:sections.store-statistics.settings.nav_btn_color.label",
      "default": "#75B2D5"
    }
  ],
  "blocks": [
    {
      "type": "number_block",
      "name": "t:sections.store-statistics.blocks.number_block.name",
      "settings": [
        {
          "type": "number",
          "id": "number",
          "label": "t:sections.store-statistics.blocks.number_block.settings.number.label",
          "default": 1500
        },
        {
          "type": "text",
          "id": "unit",
          "label": "t:sections.store-statistics.blocks.number_block.settings.unit.label",
          "default": "t:sections.store-statistics.blocks.number_block.settings.unit.default"
        },
        {
          "type": "textarea",
          "id": "icon",
          "label": "t:sections.store-statistics.blocks.number_block.settings.icon.label",
          "info": "t:sections.store-statistics.blocks.number_block.settings.icon.info",
          "default": "<svg class=\"size-6 md:size-10\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><g clip-path=\"url(#clip0_1_7780)\"><path d=\"M24 0H0V24H24V0Z\" fill=\"currentColor\" fill-opacity=\"0.01\"/><path d=\"M22 7L12 2L2 7V17L12 22L22 17V7Z\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/><path d=\"M2 7L12 12\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 22V12\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M22 7L12 12\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M17 4.5L7 9.5\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><defs><clipPath id=\"clip0_1_7780\"><rect width=\"24\" height=\"24\" fill=\"currentColor\"/></clipPath></defs></svg>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.store-statistics.name",
      "blocks": [
        {
          "type": "number_block"
        },
        {
          "type": "number_block"
        },
        {
          "type": "number_block"
        }
      ]
    }
  ]
}
{% endschema %}