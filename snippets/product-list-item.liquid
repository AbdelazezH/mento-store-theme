<div class="w-full group relative max-h-96 flex justify-start items-center gap-2 md:gap-4">
    <div class="w-1/3 lg:w-1/4 flex-shrink-0">
        <a href="{{ product.url }}"
           class="block overflow-hidden bg-gray-200 group-hover:opacity-80 rounded-sm md:rounded-md aspect-w-3 aspect-h-4"
        >
            {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: height: 352 }}"
                     alt="{{ product.featured_image.alt | escape }}"
                     width="{{ product.featured_image.width }}"
                     height="{{ product.featured_image.height }}"
                     class="w-full h-full object-cover object-center"
                     loading="lazy"
                >
            {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover object-center' }}
            {% endif %}

            <div x-data="productCardButtons({{ product.selected_or_first_available_variant.available }})"
                 class="absolute inset-0 top-1 start-1 md:top-2.5 md:start-2.5 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300">
                <div x-cloak class="inline-flex flex-col bg-white rounded divide-y divide-gray-200">
                    <!-- Add to Cart Form -->
                    <form x-on:submit="addToCart($event)"
                          class="inline-block"
                          data-message="{{ 'sections.featured_collection.item_added_successfully' | t }}">

                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <button type="submit" :disabled="loading || !available"
                                :class="loading || !available ? 'opacity-50': 'opacity-100'"
                                class="px-2 py-1.5 md:px-3 md:py-2.5 text-gray-700 hover:bg-primary-main hover:text-white hover:rounded-t">

                            <!-- Shopping Cart Icon, shown when not loading -->
                            <span x-show="!loading">
                                {% render 'icon-shopping-cart', classes: 'size-3 md:size-4.5' %}
                            </span>

                            <!-- Spinner, shown when loading -->
                            <span x-show="loading" class="flex justify-center items-center">
                            <svg class="animate-spin size-3 md:size-4.5" xmlns="http://www.w3.org/2000/svg" fill="none"
                                 viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                        stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor"
                                      d="M4 12a8 8 0 018-8v2a6 6 0 00-6 6H4z"></path>
                            </svg>
                        </span>
                        </button>
                    </form>

                    <script>
                        const optionsWithValuesList_{{ product.id }} = [
                            {% for option in product.options_with_values %}
                            {% assign isSwatchType = false %}
                            {% if option.values.size > 0 and option.values[0].swatch and option.values[0].swatch.color %}
                            {% assign isSwatchType = true %}
                            {% endif %}
                            {
                                name: '{{ option.name }}',
                                position: parseInt('{{ option.position }}', 10),
                                selected_value: '{{ option.values[0] }}',
                                values: [
                                    {% for value in option.values %}
                                    {% if value.swatch %}
                                    {
                                        name: '{{ value }}',
                                        swatch: {
                                            color: '{{ value.swatch.color }}'
                                        }
                                    }
                                    {% else %}
                                    '{{ value }}'
                                    {% endif %}
                                    {% if forloop.last == false %},{% endif %}
                                    {% endfor %}
                                ],
                                isSwatchType: '{{ isSwatchType }}' === 'true'
                            }
                            {% if forloop.last == false %},{% endif %}
                            {% endfor %}
                        ];
                    </script>

                    <button x-on:click.prevent="openQuickView('{{ product.handle }}', optionsWithValuesList_{{ product.id }})"
                            :disabled="loading"
                            :class="loading ? 'opacity-50': 'opacity-100'"
                            class="px-2 py-1.5 md:px-3 md:py-2.5 text-gray-700 hover:bg-primary-main hover:text-white">
                        <span x-show="!loading">
                            {% render 'icon-eye', classes: 'size-3 md:size-4.5' %}
                        </span>

                        <!-- Spinner, shown when loading -->
                        <span x-show="loading" class="flex justify-center items-center">
                            <svg class="animate-spin size-3 md:size-4.5" xmlns="http://www.w3.org/2000/svg" fill="none"
                                 viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                        stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor"
                                      d="M4 12a8 8 0 018-8v2a6 6 0 00-6 6H4z"></path>
                            </svg>
                        </span>
                    </button>
                    <button x-on:click.prevent="copyToClipboard('{{ shop.url }}{{ product.url }}')" :disabled="loading"
                            :class="loading ? 'opacity-50': 'opacity-100'"
                            class="px-2 py-1.5 md:px-3 md:py-2.5 text-gray-700 hover:bg-primary-main hover:text-white hover:rounded-b relative">
                        <span x-show="!loading">
                            {% render 'icon-copy', classes: 'size-2.5 md:size-4' %}
                        </span>

                        <!-- Spinner, shown when loading -->
                        <span x-show="loading" class="flex justify-center items-center">
                            <svg class="animate-spin size-3 md:size-4.5" xmlns="http://www.w3.org/2000/svg" fill="none"
                                 viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                        stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor"
                                      d="M4 12a8 8 0 018-8v2a6 6 0 00-6 6H4z"></path>
                            </svg>
                        </span>

                        <!-- Tooltip Feedback -->
                        <div x-show="copied"
                             class="absolute -end-2 top-1/2 transform -translate-y-1/2 ltr:translate-x-full rtl:-translate-x-full bg-primary-main text-white text-[6px] md:text-xs rounded py-1 px-1 md:px-2 w-10 md:w-14 max-w-16"
                             x-transition:enter="transition ease-out duration-300"
                             x-transition:enter-start="opacity-0 transform scale-90"
                             x-transition:enter-end="opacity-100 transform scale-100"
                             x-transition:leave="transition ease-in duration-300"
                             x-transition:leave-start="opacity-100 transform scale-100"
                             x-transition:leave-end="opacity-0 transform scale-90">
                            {{ 'sections.featured_collection.url_copied' | t }}
                            <!-- Arrow -->
                            <div class="absolute end-full top-1/2 transform -translate-y-1/2 ltr:translate-x-1 rtl:-translate-x-1 md:ltr:translate-x-1.5 md:rtl:-translate-x-1.5">
                                <div class="w-1.5 h-1.5 md:w-2.5 md:h-2.5 bg-primary-main rotate-45"></div>
                            </div>
                        </div>
                    </button>
                </div>
            </div>
        </a>
    </div>

    <!-- Product details -->
    <div class="w-2/3 lg:w-3/4 flex flex-col justify-between gap-4 xl:gap-6 2xl:gap-8 flex-grow">
        <div class="flex flex-col gap-2 md:gap-6">
            <div class="flex justify-start items-center gap-3">
                <span class="text-sm sm:text-base md:text-xl/4 font-normal text-gray-950"
                      style="color: {{ section.settings.color_scheme.settings.text }};">
                    {{ product.selected_or_first_available_variant.price | money }}
                </span>
                    <span class="text-xs sm:text-sm md:text-base/3 font-normal text-gray-500 line-through"
                          style="color: {{ section.settings.color_scheme.settings.secondary_light }};">
                    {{ product.selected_or_first_available_variant.compare_at_price | money }}
                </span>
            </div>

            <a href="{{ product.url }}"
               class="block text-sm sm:text-base md:text-xl/4 font-semibold text-gray-950"
               style="color: {{ section.settings.color_scheme.settings.text }};">
                {{ product.title | escape }}
            </a>

            {% if product.metafields.judgeme %}
                <div class="hidden">
                    <div class="py-3 lg:py-6 product-rating-badge product-{{ product.id }}-rating-badge">
                        <div class="flex items-center">
                            <!-- Start of Judge.me code -->
                            <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}'>
                                {{ product.metafields.judgeme.badge }}
                            </div>
                            <!-- End of Judge.me code -->
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if product.tags.size > 0 %}
                <div class="flex justify-start gap-1 md:gap-4">
                    {% for tag in product.tags limit: 3 %}
                        {% assign translation_key = 'general.tags.' | append: tag | downcase | replace: ' ', '_' %}
                        {% assign translated_tag = translation_key | t %}
                        <a href="{{ routes.all_products_collection_url }}"
                           class="text-[8px] lg:text-sm font-normal bg-gray-100 text-gray-500 rounded-full px-2 md:px-4 py-1 md:py-2">
                            {% if translated_tag contains 'Translation missing' %}
                                {{ tag }}
                            {% else %}
                                {{ translated_tag }}
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="hidden lg:flex">
            <div class="text-sm font-normal leading-normal text-gray-700 lg:line-clamp-1 xl:line-clamp-2 2xl:line-clamp-3"
            style="color: {{ section.settings.color_scheme.settings.secondary }};">
                {{ product.description | truncatewords: 50 }}
            </div>
        </div>

        <div x-data="productCardButtons">
            <form x-on:submit="addToCart($event)"
                  novalidate="novalidate"
                  data-message="{{ 'pages.cart.item_added_successfully' | t }}"
            >
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" :disabled="loading"
                        :class="loading ? 'opacity-50': 'opacity-100'"
                        class="block w-full md:w-3/5 text-xs md:text-base font-normal leading-normal text-center py-1.5 md:py-2.5 border border-gray-600 rounded-sm md:rounded hover:bg-primary-main hover:text-white hover:border-primary-main">
                    <span x-show="!loading">
                        {{ 'pages.cart.add_to_cart' | t }}
                    </span>

                    <!-- Spinner, shown when loading -->
                    <span x-show="loading" class="flex justify-center items-center">
                        <svg class="animate-spin size-3 md:size-5" xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                    stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor"
                                  d="M4 12a8 8 0 018-8v2a6 6 0 00-6 6H4z"></path>
                        </svg>
                    </span>
                </button>
            </form>
        </div>
    </div>
</div>