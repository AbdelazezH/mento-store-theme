<div x-data="quickViewModal()"
     x-cloak
     x-on:quick-view-open.window="openModal($event)"
     x-show="open" x-trap.noscroll="open"
     class="relative z-10" aria-labelledby="modal-title" role="dialog" aria-modal="true">

    <!-- Modal background -->
    <div x-show="open"
         x-transition:enter="ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>

    <div class="fixed inset-0 z-10 overflow-y-auto">
        <div class="flex min-h-full items-center justify-center px-2 md:px-0">
            <!-- Modal content -->
            <div x-show="open"
                 x-transition:enter="ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave="ease-in duration-300"
                 x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 x-on:click.outside="closeModal()"
                 class="relative transform overflow-x-hidden overflow-y-auto rounded-md bg-white shadow-xl transition-all w-full max-w-lg md:max-w-3xl lg:max-w-5xl xl:max-w-6xl p-2 max-h-[85vh] sm:max-h-[90vh]">

                <!-- Close button -->
                <div class="absolute z-40 end-0 top-0 pe-4 pt-4">
                    <button type="button" x-on:click="closeModal()"
                            class="rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-main focus:ring-offset-2">
                        <span class="sr-only">Close</span>
                        {% render 'icon-close' %}
                    </button>
                </div>

                <template x-if="loading">
                    <div class="flex justify-center items-center min-h-[85vh] sm:min-h-[60vh] lg:min-h-[85vh]">
                        <svg class="animate-spin h-10 w-10 text-primary-main" xmlns="http://www.w3.org/2000/svg"
                             fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                    stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor"
                                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                    </div>
                </template>

                <template x-if="!loading">
                    <div class="min-h-[60vh]">
                        <div class="flex flex-col md:flex-row justify-start items-start gap-4 sm:gap-6 lg:gap-12">
                            <!-- Product media -->
                            <div class="hidden md:grid w-full md:w-2/5 grid-cols-2 gap-1">
                                <template x-for="(media, index) in limitedMedia" :key="index">
                                    <div class="aspect-w-4 aspect-h-4 overflow-hidden rounded-sm md:rounded-md"
                                         :class="{ 'col-span-2': isFeaturedMedia(index) }">
                                        <img x-show="isImage(media)"
                                             :src="media.src"
                                             :alt="media.alt"
                                             class="w-full h-full object-cover object-center"
                                             loading="lazy"
                                        />
                                    </div>
                                </template>
                            </div>

                            <!-- Swiper slider for mobile devices -->
                            <div class="block md:hidden w-full">
                                <div x-ref="quickViewSwiper" class="swiper quick-view-modal__swiper">
                                    <div class="swiper-wrapper">
                                        <template x-for="(media, index) in product.media" :key="index">
                                            <div class="swiper-slide">
                                                <div class="aspect-w-4 aspect-h-4 overflow-hidden rounded-sm">
                                                    <img x-show="isImage(media)"
                                                         :src="media.src"
                                                         :alt="media.alt"
                                                         class="w-full h-full object-cover object-center"/>
                                                </div>
                                            </div>
                                        </template>
                                    </div>

                                    <div class="flex justify-center items-center gap-x-14 mt-2">

                                        <div class="swiper-button-prev !my-auto !text-gray-950">
                                        </div>

                                        <div class="swiper-pagination !text-gray-900 text-sm/6 font-medium"
                                             dir="ltr"></div>

                                        <div class="swiper-button-next !my-auto !text-gray-950">
                                        </div>

                                    </div>
                                </div>
                            </div>


                            <!-- Product details -->
                            <div class="w-full md:w-3/5 md:py-12 lg:ps-2 lg:pe-6">
                                <form x-on:submit="addToCart($event)"
                                      data-message="{{ 'sections.featured_collection.item_added_successfully' | t }}">

                                    <input type="hidden" name="id" :value="selectedVariant ? selectedVariant.id : ''">

                                    <!-- Title & Price -->
                                    <div class="py-3 lg:py-6 flex justify-between items-center">

                                        <h2 x-text="product.title"
                                            class="text-xl/4 lg:text-3xl/4 font-medium text-gray-950"></h2>

                                        <div class="flex justify-center items-center gap-2">
                                    <span class="text-lg/4 lg:text-2xl/4 text-primary-main"
                                          x-text="formatMoney(selectedVariant ? selectedVariant.price : 0, '{{ shop.currency }}')"
                                    ></span>
                                            <span class="text-sm/4 lg:text-lg/4 text-gray-300 line-through"
                                                  x-show="selectedVariant && selectedVariant.compare_at_price"
                                                  x-text="formatMoney(selectedVariant ? selectedVariant.compare_at_price : 0, '{{ shop.currency }}')"
                                            ></span>
                                        </div>
                                    </div>

                                    <!-- Ratings -->
                                    <div id="product-rating__badge"></div>

                                    <!-- Variants -->
                                    <template x-if="hasMultipleVariants">
                                        <div class="py-3 lg:py-6">
                                            <template x-for="option in product.optionsWithValues" :key="option.name">
                                                <div class="py-2">
                                                    <h3 class="text-[13px]/snug md:text-sm/snug lg:text-base/6 text-gray-950"
                                                        x-text="option.name"></h3>

                                                    <fieldset class="mt-3 product-form__input">
                                                        <div :class="option.isSwatchType ? 'ps-1.5 md:ps-0 gap-4 lg:gap-5' : 'gap-2 lg:gap-3'"
                                                             class="flex items-center">
                                                            <template x-for="(value, index) in option.values" :key="index">
                                                                <label class="relative flex items-center justify-center focus:outline-none cursor-pointer"
                                                                       :class="[
                                                                    option.isSwatchType
                                                                        ? 'color-variant__label -m-0.5 rounded-full p-0.5 ring-gray-400'
                                                                        : 'variant__label min-w-8 md:min-w-10 lg:min-w-12 min-h-8 md:min-h-10 lg:min-h-12 rounded-sm border py-1.5 px-1.5 lg:py-3 lg:px-3 text-[10px]/snug md:text-sm/snug text-gray-500 font-normal uppercase hover:bg-gray-50 bg-white',
                                                                    option.isSwatchType && !isAvailable && selectedOptions[option.name] === value.name ? 'not-available' : ''
                                                                ]"
                                                                >
                                                                    <input type="radio"
                                                                           :name="option.name"
                                                                           :id="`quick-view-${option.position}-${index}`"
                                                                           :value="value.name || value"
                                                                           x-model="selectedOptions[option.name]"
                                                                           x-on:change="selectOption(option.name, value.name || value)"
                                                                           :checked="option.selected_value === (value.name || value)"
                                                                           class="sr-only">
                                                                    <template x-if="value.swatch">
                                                                <span class="size-5 lg:size-8 bg-gray-400 rounded-full border border-black border-opacity-10"
                                                                      :style="{ backgroundColor: value.swatch.color }"></span>
                                                                    </template>

                                                                    <template x-if="!value.swatch">
                                                                <span>
                                                                    <span x-text="value"></span>
                                                                    <span aria-hidden="true"
                                                                          class="pointer-events-none absolute -inset-px rounded-sm border-2 border-gray-200"
                                                                          :class="!isAvailable && selectedOptions[option.name] === value ? 'not-available' : 'hidden'"
                                                                    >
                                                                        <svg class="absolute inset-0 h-full w-full stroke-2 text-gray-200"
                                                                             viewBox="0 0 100 100"
                                                                             preserveAspectRatio="none"
                                                                             stroke="currentColor">
                                                                          <line x1="0" y1="100" x2="100" y2="0"
                                                                                vector-effect="non-scaling-stroke"/>
                                                                        </svg>
                                                                    </span>
                                                                </span>
                                                                    </template>
                                                                </label>
                                                            </template>
                                                        </div>
                                                    </fieldset>
                                                </div>
                                            </template>
                                        </div>
                                    </template>

                                    <!-- Quantity & Add to cart -->
                                    <div class="py-3 lg:py-6">
                                        <div class="flex justify-between items-center gap-2 lg:gap-4">
                                            <div class="border border-gray-200">
                                                <div class="flex items-center gap-x-2" x-data="{
                                        quantity: 1,
                                        init() {
                                           this.$watch('quantity', value => {
                                               if (value <= 1) {
                                                   this.quantity = 1
                                               } else if (value >= 10) {
                                                   this.quantity = 10
                                               } else {
                                                   this.quantity = value
                                               }
                                           })
                                        },
                                        increment() {
                                            this.quantity >= 10 ? this.quantity = 10 : this.quantity++;
                                        },
                                        decrement() {
                                            this.quantity <= 1 ? this.quantity = 1 : this.quantity--;
                                        }

                                    }">
                                                    <button x-on:click.prevent="increment()"
                                                            x-bind:class="{'opacity-25 cursor-not-allowed': quantity >= 10 }"
                                                            class="inline-flex justify-center items-center px-3 lg:px-6 py-[11px] lg:py-[13px]">
                                                        {% render 'icon-plus', classes: 'size-4 lg:size-5' %}
                                                    </button>
                                                    <span class="w-4 md:w-6 lg:w-8 p-0 bg-transparent border-0 text-base md:text-lg text-primary-main text-center"
                                                          x-text="quantity"></span>
                                                    <label for="quantity-{{ section.id }}" class="sr-only"></label>
                                                    <input type="hidden" name="quantity" id="quantity-{{ section.id }}"
                                                           class="w-4 md:w-6 lg:w-8 p-0 bg-transparent border-0 outline-none text-base md:text-lg text-primary-main text-center focus:ring-0 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                                                           style="-moz-appearance: textfield;"
                                                           x-model="quantity" min="1" max="10">
                                                    <button x-on:click.prevent="decrement()"
                                                            x-bind:class="{'opacity-25 cursor-not-allowed': quantity <= 1}"
                                                            class="inline-flex justify-center items-center px-3 lg:px-6 py-[11px] lg:py-[13px]">
                                                        {% render 'icon-minus', classes: 'size-4 lg:size-5' %}
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="flex-1">
                                                <button type="submit" name="add"
                                                        data-text-add-to-cart="{{ 'pages.product.add_to_cart' | t }}"
                                                        data-text-out-of-stock="{{ 'pages.product.out_of_stock' | t }}"
                                                        class="w-full text-sm/4 lg:text-base/normal font-medium text-white bg-primary-main rounded-sm py-3"
                                                        :disabled="!isAvailable"
                                                        :class="isAvailable ? 'cursor-pointer' : 'cursor-not-allowed opacity-25'"
                                                        x-ref="submitButton"
                                                >
                                                    <span x-text="buttonText"></span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>
