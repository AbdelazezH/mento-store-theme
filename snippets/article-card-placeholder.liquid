<div class="swiper-slide group relative max-w-40 md:max-w-full">
    <a href="#" class="block overflow-hidden w-full bg-gray-200 rounded-t-sm md:rounded-md aspect-h-4 aspect-w-4">
        {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover object-center' }}
        <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black transition-opacity duration-300 opacity-100 group-hover:opacity-0"></div>
    </a>

    <div class="mt-2 md:mt-5 ps-1.5 md:ps-0 flex flex-col justify-between gap-3 md:gap-5">
        <div class="flex flex-col justify-between gap-1.5 md:gap-4">
            <div class="flex flex-col gap-1 md:gap-2">
                <h2 class="text-[0.625rem]/3 md:text-xl font-normal text-gray-900"
                    style="color: {{ section.settings.color_scheme.settings.text }};">
                    {{ 'sections.featured_articles.title_placeholder' | t }}
                </h2>
                <h4 class="text-[0.375rem]/3 md:text-xs/6 font-normal text-gray-500"
                    style="color: {{ section.settings.color_scheme.settings.secondary_light }};">
                    {{ 'sections.featured_articles.date_placeholder' | t }}
                </h4>
            </div>

            <div class="text-[0.5rem]/4 md:text-sm/6 font-normal text-gray-700 line-clamp-2"
                 style="color: {{ section.settings.color_scheme.settings.secondary }};">
                {{ 'sections.featured_articles.content_placeholder' | t }}
            </div>
        </div>

        <a href="#" class="flex items-center gap-2 md:gap-6 text-[0.5rem] md:text-sm/6 text-gray-900 hover:font-medium"
           style="color: {{ section.settings.color_scheme.settings.text }};">
            <span>
                {{ 'sections.featured_articles.read_more' | t }}
            </span>
            <span>
                {% render 'icon-arrow-long-left', classes: 'size-3 md:size-6 ltr:rotate-180' %}
            </span>
        </a>
    </div>
</div>