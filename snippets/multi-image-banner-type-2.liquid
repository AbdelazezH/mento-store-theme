<style>
    .multi-banner-text_on_hover:hover {
        color: {{ primary_color }} !important;
    }
</style>

<div class="bg-secondary-light px-2 pt-2 pb-4" style="background-color: {{ background }};">
    <div class="grid grid-cols-10 gap-1 md:gap-3 page-width">
        {% assign number_of_blocks = section.blocks.size %}
        {% for block in section.blocks %}
            {% assign indexMod = forloop.index | modulo: 6 %}
            {% if indexMod == 1 or indexMod == 5 %}
                {% if indexMod == 1 and forloop.index == number_of_blocks %}
                    {% assign colClass = 'col-span-10 row-span-2 h-[222px] md:h-[357px]' %}
                {% elsif indexMod == 5 and forloop.index == number_of_blocks %}
                    {% assign colClass = 'col-span-10 md:col-span-7 h-[222px] md:h-[357px]' %}
                {% elsif indexMod == 5 and forloop.index != number_of_blocks %}
                    {% assign colClass = 'col-span-5 md:col-span-7 md:row-span-2 h-[222px] md:h-[722px]' %}
                {% else %}
                    {% assign colClass = 'col-span-10 md:col-span-7 md:row-span-2 h-[222px] md:h-[722px]' %}
                {% endif %}
                {% assign type = 1 %}
            {% elsif indexMod == 2 %}
                {% if forloop.index == number_of_blocks %}
                    {% assign colClass = 'col-span-10 md:col-span-3 md:row-span-2 h-[222px] md:h-[722px]' %}
                {% else %}
                    {% assign colClass = 'col-span-5 md:col-span-3 h-[222px] md:h-[357px]' %}
                {% endif %}
                {% assign type = 2 %}
            {% elsif indexMod == 4 %}
                {% if forloop.index == number_of_blocks %}
                    {% assign colClass = 'col-span-10 h-[222px] md:h-[357px]' %}
                {% else %}
                    {% assign colClass = 'col-span-10 md:col-span-3 h-[222px] md:h-[357px]' %}
                {% endif %}
                {% assign type = 2 %}
            {% else %}
                {% assign colClass = 'col-span-5 md:col-span-3 h-[222px] md:h-[357px]' %}
                {% assign type = 2 %}
            {% endif %}
            <div class="relative overflow-hidden {{ colClass }}">
                {% if type == 1 %}
                    <div>
                        {% if block.settings.banner_image != blank %}
                            <img src="{{ block.settings.banner_image | img_url: 'master' }}"
                                 alt="{{ block.settings.banner_image.alt }}"
                                 class="object-cover object-center group-hover:opacity-75 absolute inset-0 h-full w-full"
                                 loading="lazy"
                            >
                        {% else %}
                            {{ 'collection-1' | placeholder_svg_tag: 'object-cover object-center group-hover:opacity-75 absolute inset-0 h-full w-full' }}
                        {% endif %}
                        <div aria-hidden="true"
                             class="bg-gradient-to-b from-transparent to-black opacity-50 absolute inset-0"></div>

                        <div class="flex {{ block.settings.justify_content }} {{ block.settings.align_items }} md:px-5 md:py-6 absolute inset-0">
                            {% case block.settings.text_align %}
                                {% when 'text-start' %}
                                    {% assign align_inside_content = 'items-start' %}
                                {% when 'text-center' %}
                                    {% assign align_inside_content = 'items-center' %}
                                {% when 'text-end' %}
                                    {% assign align_inside_content = 'items-end' %}
                            {% endcase %}
                            <div class="p-3 flex flex-col {{ align_inside_content }}">
                                {% if block.settings.banner_title != blank %}
                                    <h3 class="text-2xl/5 md:text-4xl/5 text-white font-medium mb-2 md:mb-6 {{ block.settings.text_align }}"
                                        style="color: {{ block.settings.color_scheme.settings.text }};">
                                        {{ block.settings.banner_title }}
                                    </h3>
                                {% endif %}

                                {% if block.settings.sub != blank %}
                                    <p class="text-sm/5 md:text-base/5 text-white font-normal mb-4 md:mb-6 {{ block.settings.text_align }}"
                                       style="color: {{ block.settings.color_scheme.settings.secondary }};">
                                        {{ block.settings.sub }}
                                    </p>
                                {% endif %}

                                {% if block.settings.banner_btn != blank %}
                                    <a href="{{ block.settings.banner_url }}"
                                       class="text-xs/tight md:text-xl/normal text-primary-main text-center bg-white hover:bg-opacity-90 rounded font-normal px-4 md:px-6 py-2 md:py-3"
                                       style="color: {{ block.settings.color_scheme.settings.button_label }}; background-color: {{ block.settings.color_scheme.settings.button }};">
                                        {{ block.settings.banner_btn }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="h-full flex flex-col gap-1 md:gap-2">
                        <div class="relative overflow-hidden flex-1">
                            {% if block.settings.banner_image != blank %}
                                <img src="{{ block.settings.banner_image | img_url: 'master' }}"
                                     alt="{{ block.settings.banner_image.alt }}"
                                     class="object-cover object-center group-hover:opacity-75 absolute inset-0 h-full w-full"
                                     loading="lazy"
                                >
                            {% else %}
                                {{ 'collection-1' | placeholder_svg_tag: 'object-cover object-center group-hover:opacity-75 absolute inset-0 h-full w-full' }}
                            {% endif %}

                            <div aria-hidden="true"
                                 class="bg-gradient-to-b from-transparent to-black opacity-50 absolute inset-0"></div>
                        </div>

                        {% if block.settings.banner_title != blank %}
                            <div class="{{ block.settings.text_align }}">
                                <h3 class="text-sm/5 md:text-base/5 text-gray-700 hover:text-gray-900 multi-banner-text_on_hover" style="color: {{ secondary_color }}">
                                    <a href="{{ block.settings.banner_url }}">
                                        {{ block.settings.banner_title }}
                                    </a>
                                </h3>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>