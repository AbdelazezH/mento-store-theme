<aside x-data="{ openMobileMenu: false }"
       x-cloak
       x-show="openMobileMenu" x-trap.noscroll="openMobileMenu"
       x-on:mobile-menu-opened.window="openMobileMenu = true;"
       class="relative z-40" aria-label="Sidenav">

    <div x-show="openMobileMenu"
         x-transition:enter="ease-in-out duration-500"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="ease-in-out duration-500"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>

    <div class="fixed inset-0 overflow-hidden">
        <div class="absolute inset-0 overflow-hidden">
            <div class="pointer-events-none fixed inset-y-0 start-0 flex max-w-full pe-10">

                <div x-show="openMobileMenu"
                     x-on:click.outside="openMobileMenu = false;"
                     x-transition:enter="transform transition ease-in-out duration-500"
                     x-transition:enter-start="-translate-x-full rtl:translate-x-full"
                     x-transition:enter-end="translate-x-0"
                     x-transition:leave="transform transition ease-in-out duration-500"
                     x-transition:leave-start="translate-x-0"
                     x-transition:leave-end="-translate-x-full rtl:translate-x-full"
                     class="pointer-events-auto w-screen max-w-md">
                    <div class="flex h-full flex-col overflow-y-scroll bg-white py-6 shadow-xl">
                        <div class="px-4">
                            <div class="flex items-start justify-end">
                                <div class="flex h-7 items-center">
                                    <button type="button"
                                            x-on:click="openMobileMenu = false;"
                                            class="text-gray-500 hover:text-gray-900">
                                        <span class="sr-only">Close menu</span>
                                        {% render 'icon-close', classes: 'size-9' %}
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="relative mt-6 flex-1">
                            <hr class="my-3 bg-[#EEE]">

                            <nav class="flex flex-col divide-y divide-gray-100 ps-4">
                                {% for link in section.settings.main_menu.links %}
                                    <div class="py-3">
                                        {% if link.links != blank %}
                                            <div class="relative" x-data="{ open: false }">
                                                <button
                                                        type="button"
                                                        x-on:click="open = !open"
                                                        class="text-base pe-2 text-[#9A9A9A] hover:text-[#212121] flex items-center justify-between w-full">
                                                    <span>{{ link.title }}</span>
                                                    {% render 'icon-dropdown', classes: 'size-7' %}
                                                </button>

                                                <div
                                                        x-show="open"
                                                        class="grid py-2 gap-y-2">
                                                    {% for childlink in link.links %}
                                                        <a href="{{ childlink.url }}"
                                                           class="px-2 mt-1 flex items-center text-[#9A9A9A] hover:text-[#212121]"
                                                        >
                                                            <span class="ms-3">{{ childlink.title }}</span>
                                                        </a>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% else %}
                                            <a class="block text-base {% if forloop.first %}text-[#212121]{% else %}text-[#9A9A9A]{% endif %} hover:text-[#212121]"
                                               href="{{ link.url }}">{{ link.title }}</a>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </nav>

                            <div class="ps-4">
                                <hr class="mt-3 bg-gray-100">
                            </div>

                            <div class="py-3 ps-4">
                                <div class="relative"
                                     x-data="languagePicker(
                                            '{{ settings.show_lang_picker }}',
                                            '{{ localization.language.iso_code }}',
                                            '{{ settings.default_language_code }}',
                                            availableLocales)">
                                    <button
                                            type="button"
                                            x-on:click="open = !open"
                                            class="text-base pe-2 text-[#9A9A9A] hover:text-[#212121] flex items-center justify-between w-full">
                                        <div class="flex justify-center ltr:flex-row-reverse items-center gap-1">
                                            <span class="text-sm border-l-2 border-[#9A9A9A] hover:border-[#212121] pl-1"
                                                  x-text="currentLang.toUpperCase()"></span>
                                            {% render 'icon-language', classes: 'size-5' %}
                                        </div>
                                        {% render 'icon-dropdown', classes: 'size-7' %}
                                    </button>

                                    <div x-show="open"
                                         class="grid py-2 gap-y-2">
                                        <template x-for="language in languages"
                                                  :key="language.locale">
                                            <a :href="generateUrl(language.locale)"
                                               class="px-2 mt-1 flex items-center text-sm text-[#9A9A9A] hover:text-[#212121]">
                                                <span class="ms-3" x-text="language.nativeName"></span>
                                            </a>
                                        </template>
                                    </div>
                                </div>
                            </div>

                            <div class="ps-4">
                                <hr class="mb-3 bg-gray-100">
                            </div>

                            <div class="pt-4 pb-2 ps-4">
                                <ul class="text-primary-main flex justify-start items-center gap-4">
                                    {% if settings.youtube_link != blank %}
                                        <li>
                                            <a href="{{ settings.youtube_link }}">
                                                {% render 'icon-youtube' %}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if settings.linkedin_link != blank %}
                                        <li>
                                            <a href="{{ settings.linkedin_link }}">
                                                {% render 'icon-linkedin' %}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if settings.x_link != blank %}
                                        <li>
                                            <a href="{{ settings.x_link }}">
                                                {% render 'icon-x' %}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if settings.instagram_link != blank %}
                                        <li>
                                            <a href="{{ settings.instagram_link }}">
                                                {% render 'icon-instagram' %}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if settings.facebook_link != blank %}
                                        <li>
                                            <a href="{{ settings.facebook_link }}">
                                                {% render 'icon-facebook' %}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if settings.tiktok_link != blank %}
                                        <li>
                                            <a href="{{ settings.tiktok_link }}">
                                                {% render 'icon-tiktok' %}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if settings.telegram_link != blank %}
                                        <li>
                                            <a href="{{ settings.telegram_link }}">
                                                {% render 'icon-telegram' %}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if settings.snapchat_link != blank %}
                                        <li>
                                            <a href="{{ settings.snapchat_link }}">
                                                {% render 'icon-snapchat' %}
                                            </a>
                                        </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</aside>