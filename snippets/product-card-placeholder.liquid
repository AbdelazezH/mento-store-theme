<!-- product card placeholder -->
<div class="swiper-slide group relative max-w-40 md:max-w-full">
    {% comment %} Fixed Size before: h-52 sm:h-80 md:h-[408px] lg:h-[522px] {% endcomment %}
    <div class="relative overflow-hidden w-full bg-gray-200 rounded-sm md:rounded-md aspect-w-3 aspect-h-4">
        {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover object-center' }}
        <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black transition-opacity duration-300 opacity-100 group-hover:opacity-0"></div>
    </div>

    <div class="mt-3 md:mt-4 flex flex-col justify-between gap-4 md:gap-6">
        <div>
            <div class="flex justify-start items-center gap-3">
                <span class="text-sm sm:text-base md:text-xl/4 font-normal text-gray-950"
                      style="color: {{ section.settings.color_scheme.settings.text }};">$40</span>
                <span class="text-xs sm:text-sm md:text-base/3 font-normal text-gray-500 line-through"
                      style="color: {{ section.settings.color_scheme.settings.secondary_light }};">$40</span>
            </div>

            <h3 class="text-sm sm:text-base md:text-xl/4 font-semibold text-gray-950 mt-1 md:mt-6"
                style="color: {{ section.settings.color_scheme.settings.text }};">
                {{ 'sections.featured_collection.product_title_placeholder' | t }}
            </h3>
        </div>

        <div class="flex justify-start gap-1 md:gap-4">
            {% for i in (1..3) %}
                <a href="#"
                   class="text-[8px] lg:text-sm font-normal bg-gray-100 text-gray-500 rounded-full px-2 md:px-4 py-1 md:py-2"
                   style="background-color: {{ section.settings.color_scheme.settings.secondary_button }}; color: {{ section.settings.color_scheme.settings.secondary_button_label }};">
                    {{ 'sections.featured_collection.tag_placeholder' | t }}
                </a>
            {% endfor %}
        </div>
    </div>
</div>