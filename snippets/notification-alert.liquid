<div x-data="{
    show: false,
    timeout: null,
    message: '',
    showNotification(msg) {
        this.message = msg;
        this.show = true;
        clearTimeout(this.timeout);
        this.timeout = setTimeout(() => {
            this.show = false;
        }, 3000);
    },
    closeNotification() {
        this.show = false;
        clearTimeout(this.timeout);
    }
}"
     x-cloak
     x-show="show"
     x-transition:enter="transition transform ease-out duration-300"
     x-transition:enter-start="ltr:-translate-x-full rtl:translate-x-full opacity-0"
     x-transition:enter-end="translate-x-0 opacity-100"
     x-transition:leave="transition transform ease-in duration-300"
     x-transition:leave-start="translate-x-0 opacity-100"
     x-transition:leave-end="ltr:-translate-x-full rtl:translate-x-full opacity-0"
     x-on:item-added.window="showNotification($event.detail.message)"
     aria-live="assertive"
     class="pointer-events-none fixed inset-0 flex items-start px-4 py-6 sm:p-6 z-50">
    <div class="flex w-full flex-col space-y-4 items-start">
        <div class="pointer-events-auto w-full max-w-sm overflow-hidden rounded-lg bg-white shadow-lg ring-1 ring-black ring-opacity-5">
            <div class="p-4">
                <div class="flex items-start">
                    <div class="flex-shrink-0 text-green-400">
                        {% render 'icon-success' %}
                    </div>
                    <div class="ms-3 w-0 flex-1 pt-0.5">
                        <p class="text-sm font-medium text-gray-900" x-text="message"></p>
                    </div>
                    <div class="ms-4 flex flex-shrink-0">
                        <button type="button"
                                x-on:click="closeNotification()"
                                class="inline-flex rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-main focus:ring-offset-2">
                            <span class="sr-only">Close</span>
                            {% render 'icon-close', classes: 'size-6' %}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
