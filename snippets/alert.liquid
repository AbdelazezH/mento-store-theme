{% liquid
    if type == 'success'
        assign bgColor = 'bg-green-50'
        assign iconColor = 'text-green-400'
        assign textColor = 'text-green-800'
    elsif type == 'error'
        assign bgColor = 'bg-red-50'
        assign iconColor = 'text-red-400'
        assign textColor = 'text-red-800'
    endif
%}

<div class="rounded-md {{ bgColor }} mb-2.5 p-4">
    <div class="flex items-center">
        <div class="flex-shrink-0 {{ iconColor }}">
            {% if type == 'success' %}
                {% render 'icon-success' %}
            {% elsif type == 'error' %}
                {% render 'icon-error' %}
            {% endif %}
        </div>
        <div class="ms-3">
            <h3 class="text-base font-medium {{ textColor }}">
                {% if plain %}
                    {{ text }}
                {% else %}
                    {{ text | t }}
                {% endif %}
            </h3>
        </div>
    </div>
</div>