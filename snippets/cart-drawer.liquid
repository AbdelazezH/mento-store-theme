<div id="cart-drawer-overlay" class="cart-drawer-overlay" aria-hidden="true"></div>

{% comment %} Get free shipping settings from cart section if available, otherwise use defaults {% endcomment %}
{% assign enable_free_shipping = false %}
{% assign free_shipping_threshold = 0 %}
{% for block in section.blocks %}
  {% if block.type == '@app' and block.settings.app == 'cart' %}
    {% if block.settings.enable_free_shipping_threshold %}
      {% assign enable_free_shipping = true %}
      {% assign free_shipping_threshold = block.settings.free_shipping_threshold %}
    {% endif %}
  {% endif %}
{% endfor %}

<div id="cart-drawer"
     class="cart-drawer"
     role="dialog"
     aria-modal="true"
     aria-label="{{ 'pages.cart_drawer.title' | t }}"
     data-title="{{ 'pages.cart_drawer.title' | t }}"
     data-empty-text="{{ 'pages.cart_drawer.empty_text' | t }}"
     data-empty-btn="{{ 'pages.cart_drawer.empty_btn' | t }}"
     data-subtotal="{{ 'pages.cart_drawer.subtotal' | t }}"
     data-checkout="{{ 'pages.cart_drawer.checkout' | t }}"
     data-view-cart="{{ 'pages.cart_drawer.view_cart' | t }}"
     data-remove="{{ 'pages.cart_drawer.remove' | t }}"
     data-item-added="{{ 'pages.cart_drawer.item_added' | t }}"
     data-shop-url="{{ routes.all_products_collection_url }}"
     data-enable-free-shipping="{{ enable_free_shipping }}"
     data-free-shipping-threshold="{{ free_shipping_threshold }}"
     data-free-shipping-before="{{ 'pages.cart_drawer.free_shipping_before' | t }}"
     data-free-shipping-after="{{ 'pages.cart_drawer.free_shipping_after' | t }}"
     data-free-shipping-reached="{{ 'pages.cart_drawer.free_shipping_reached' | t }}"
     data-discount-label="{{ 'pages.cart_drawer.discount_label' | t }}"
     data-discount-placeholder="{{ 'pages.cart_drawer.discount_placeholder' | t }}"
     data-discount-apply="{{ 'pages.cart_drawer.discount_apply' | t }}"
     data-discount-remove="{{ 'pages.cart_drawer.discount_remove' | t }}"
>

  <div class="cart-drawer-header">
    <h2>{{ 'pages.cart_drawer.title' | t }}</h2>
    <button type="button" class="cart-drawer-close" aria-label="{{ 'pages.cart_drawer.close' | t }}">
      {% render 'icon-close', classes: 'size-5' %}
    </button>
  </div>

  <div class="cart-drawer-body">
    <div class="cart-drawer-loading">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
    </div>
  </div>

  <div class="cart-drawer-footer"></div>

</div>
