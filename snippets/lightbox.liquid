<div x-data="{
    open: false,
    loading: false,
    swiperInstance: null,
    openLightbox(event) {
        this.loading = true;
        this.open = true;
        const startIndex = event.detail.startIndex;

        this.$nextTick(() => {
            this.initSwiper(startIndex);
            this.$refs.nextButton.focus();
        });

        this.loading = false;
    },

    closeLightbox() {
        if (this.swiperInstance) {
            this.swiperInstance.destroy();
            this.swiperInstance = null;
        }
        this.open = false;
    },

    initSwiper(startIndex = 0) {
        const swiperContainer = this.$refs.lightboxSwiper;

        if (!this.swiperInstance && swiperContainer) {
            this.swiperInstance = new window.Swiper(swiperContainer, {
                modules: [window.SwiperPagination, window.SwiperNavigation],
                pagination: {
                    el: swiperContainer.querySelector('.swiper-pagination'),
                    type: 'fraction',
                    clickable: true
                },
                navigation: {
                    nextEl: swiperContainer.querySelector('.swiper-button-next'),
                    prevEl: swiperContainer.querySelector('.swiper-button-prev')
                },
                initialSlide: startIndex,
                slidesPerView: 1,
                spaceBetween: 10,
                speed: 600
            });
        } else if (this.swiperInstance) {
            this.swiperInstance.slideTo(startIndex);
        }
    },

    handleKeydown(event) {
        if (!this.open) return;

        const isRtl = document.documentElement.dir === 'rtl';

        if (event.key === 'ArrowLeft') {
            // Navigate to the previous slide
            if (this.swiperInstance) {
                isRtl ? this.swiperInstance.slideNext() : this.swiperInstance.slidePrev();
            }
        } else if (event.key === 'ArrowRight') {
            // Navigate to the next slide
            if (this.swiperInstance) {
                isRtl ? this.swiperInstance.slidePrev() : this.swiperInstance.slideNext();
            }
        } else if (event.key === 'Escape') {
            this.closeLightbox();
        }
    }
}"
     x-cloak
     x-on:lightbox-open.window="openLightbox($event)"
     x-on:keydown.window="handleKeydown($event)"
     x-show="open"
     x-trap.noscroll="open"
     class="relative z-10" aria-labelledby="modal-title" role="dialog" aria-modal="true">

    <!-- Modal background -->
    <div x-show="open"
         x-transition:enter="ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>

    <div class="fixed inset-0 z-10 overflow-y-auto">
        <div class="flex min-h-full items-center justify-center px-2 md:px-0">
            <!-- Modal content -->
            <div x-show="open"
                 x-transition:enter="ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave="ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 x-on:click.outside="closeLightbox()"
                 class="relative transform overflow-x-hidden overflow-y-auto rounded-md bg-white shadow-xl transition-all w-full max-w-lg md:max-w-3xl lg:max-w-5xl p-2 max-h-[80vh] sm:max-h-[90vh]">

                <!-- Close button -->
                <div class="absolute z-40 end-0 top-0 pe-4 pt-4">
                    <button type="button" x-on:click="closeLightbox()"
                            class="rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-main focus:ring-offset-2">
                        <span class="sr-only">Close</span>
                        {% render 'icon-close' %}
                    </button>
                </div>

                <div class="flex justify-center items-center min-h-[85vh] px-3 py-2">
                    <template x-if="loading">
                        <svg class="animate-spin h-10 w-10 text-primary-main" xmlns="http://www.w3.org/2000/svg"
                             fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                    stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor"
                                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                    </template>

                    <template x-if="!loading">
                        <div class="w-full max-w-4xl mx-auto max-h-[85vh] overflow-y-auto">
                            <div x-ref="lightboxSwiper" class="swiper lightbox__swiper">
                                <div class="swiper-wrapper">
                                    {% for media in product.media %}
                                        <div class="swiper-slide">
                                            {% case media.media_type %}
                                                {% when 'image' %}
                                                    <div x-data="zoomableImage(1.75)"
                                                         class="flex justify-center items-center overflow-hidden rounded-md"
                                                         :class="isZoomed ? 'cursor-zoom-out' : 'cursor-zoom-in'"
                                                         x-on:mousemove="updateMouseOffset($event)"
                                                         x-on:mouseleave="resetZoomState()"
                                                         x-on:click="toggleZoom()"
                                                    >
                                                        <img src="{{ media | img_url: 'master' }}"
                                                             alt="{{ media.preview_image.alt }}"
                                                             class="max-w-full max-h-[70vh] object-contain transition-transform duration-300 ease-in-out"
                                                             :style="zoomStyles"
                                                             loading="lazy"
                                                        >
                                                    </div>
                                            {% endcase %}
                                        </div>
                                    {% endfor %}
                                </div>

                                <div class="flex justify-center items-center gap-x-14 py-2 mt-6">

                                    <button x-ref="prevButton" aria-label="Previous image"
                                            class="swiper-button-prev px-2.5 py-0.5 !my-auto !text-gray-950 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-main focus:ring-offset-2"
                                            tabindex="0" role="button">
                                    </button>

                                    <div class="swiper-pagination !text-gray-900 text-lg/6 font-medium"
                                         dir="ltr"></div>

                                    <button x-ref="nextButton" aria-label="Next image"
                                            class="swiper-button-next px-2.5 py-0.5 !my-auto !text-gray-950 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-main focus:ring-offset-2"
                                            tabindex="0" role="button">
                                    </button>

                                </div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>
</div>
