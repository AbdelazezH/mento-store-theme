<div class="flex justify-center items-center gap-1.5 md:gap-2.5 overflow-hidden">
    {% if thumbnail.image != blank %}
        <div class="overflow-hidden w-10 h-[52px] md:w-[53px] md:h-[70px] rounded shrink-0">
            <img src="{{ thumbnail.image | img_url: 'master' }}"
                 alt="{{ thumbnail.image.alt }}"
                 class="w-full h-full object-cover object-center"
                 loading="lazy"
            >
        </div>
    {% else %}
        <div class="overflow-hidden w-10 h-[52px] md:w-[53px] md:h-[70px] rounded bg-gray-200 shrink-0">
            {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover object-center' }}
        </div>
    {% endif %}
    <div class="flex justify-center items-center gap-1">
        {% if thumbnail.link_text != blank and thumbnail.link_url != blank %}
            <a href="{{ thumbnail.link_url }}"
               class="text-sm md:text-lg font-normal leading-normal text-gray-900"
               style="color: {{ section.settings.color_scheme.settings.text }};">
                {{ thumbnail.link_text }}
            </a>
        {% endif %}

        {% if thumbnail.icon != blank %}
            <span class="text-primary-gold" style="color: {{ section.settings.color_scheme.settings.icons }};">
                {{ thumbnail.icon }}
            </span>
        {% endif %}
    </div>
</div>