<aside x-data="{
        openMobileFilters: false,
        loading: false,
        toggleLoading(isLoading) {
            this.loading = isLoading;
        }
    }"
       x-cloak
       x-show="openMobileFilters"
       x-trap.noscroll="openMobileFilters"
       x-on:mobile-filters-opened.window="openMobileFilters = true;"
       x-on:loading-start.window="toggleLoading(true)"
       x-on:loading-stop.window="toggleLoading(false)"
       class="relative z-40" aria-label="Sidenav">

    <div x-show="openMobileFilters"
         x-transition:enter="ease-in-out duration-500"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="ease-in-out duration-500"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>

    <div class="fixed inset-0 overflow-hidden">
        <div class="absolute inset-0 overflow-hidden">
            <div class="pointer-events-none fixed inset-y-0 start-0 flex max-w-full">
                <div x-show="openMobileFilters"
                     x-on:click.outside="openMobileFilters = false;"
                     x-transition:enter="transform transition ease-in-out duration-500"
                     x-transition:enter-start="-translate-x-full rtl:translate-x-full"
                     x-transition:enter-end="translate-x-0"
                     x-transition:leave="transform transition ease-in-out duration-500"
                     x-transition:leave-start="translate-x-0"
                     x-transition:leave-end="-translate-x-full rtl:translate-x-full"
                     class="pointer-events-auto w-screen max-w-md">
                    <div class="flex h-full flex-col overflow-y-scroll bg-white py-6 shadow-xl"
                         style="background-color: {{ section.settings.color_scheme.settings.background }};">
                        <div class="px-4">
                            <div class="flex items-center justify-between">
                                <h2 class="text-xl font-normal leading-normal text-primary-main">
                                    {{ 'pages.collection.filter' | t }}
                                </h2>
                                <div class="flex h-7 items-center">
                                    <button type="button"
                                            x-on:click="openMobileFilters = false;"
                                            class="text-gray-500 hover:text-gray-900">
                                        <span class="sr-only">Close menu</span>
                                        {% render 'icon-close', classes: 'size-9' %}
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="relative mt-6 flex-1 ps-4"
                             :class="loading ? 'pe-4': 'pe-12'"
                        >
                            <div x-show="loading"
                                 x-cloak>
                                {% render 'loader' %}
                            </div>
                            <div x-show="!loading"
                                 x-cloak
                                 id="mobileFilters">
                                {% render 'filters', type: type, displayMode: 'mobile' %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</aside>