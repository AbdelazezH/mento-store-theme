<div class="swiper-slide max-w-40 md:max-w-full">
    <div class="flex flex-col items-center justify-center gap-4 md:gap-6">
        <!-- image -->
        <div class="w-full bg-gray-300 aspect-w-3 aspect-h-4 md:aspect-w-4">
            {% if member.image != blank %}
                <img src="{{ member.image | img_url: 'master' }}"
                     alt="{{ member.name }}"
                     class="w-full h-full object-cover object-center"
                     loading="lazy"
                >
            {% endif %}
        </div>

        {% if member.name != blank or member.job_title != blank or member.description != blank %}
            <!-- Details -->
            <div class="flex flex-col items-center justify-center gap-3 md:gap-4">
                {% if member.name != blank %}
                    <h4 class="text-sm md:text-xl font-normal leading-normal text-primary-main"
                        style="color: {{ section.settings.color_scheme.settings.text }};">
                        {{ member.name }}
                    </h4>
                {% endif %}

                {% if member.job_title != blank %}
                    <p class="text-sm md:text-lg font-normal leading-normal text-gray-900"
                       style="color: {{ section.settings.color_scheme.secondary }};">
                        {{ member.job_title }}
                    </p>
                {% endif %}

                {% if member.description != blank %}
                    <p class="text-sm md:text-lg font-normal leading-normal text-gray-900"
                       style="color: {{ section.settings.color_scheme.settings.secondary_light }};">
                        {{ member.description }}
                    </p>
                {% endif %}
            </div>
        {% endif %}

        {% if member.link_1 != blank or member.link_2 != blank or member.link_3 != blank or member.link_4 != blank %}
            <!-- Links -->
            <div class="flex flex-row items-center gap-3.5 text-primary-main"
                 style="color: {{ section.settings.color_scheme.settings.icons }};">
                {% if member.link_1 != blank %}
                    <a href="{{ member.link_1 }}">
                        {{ section.settings.icon_1 }}
                    </a>
                {% endif %}

                {% if member.link_2 != blank %}
                    <a href="{{ member.link_2 }}">
                        {{ section.settings.icon_2 }}
                    </a>
                {% endif %}

                {% if member.link_3 != blank %}
                    <a href="{{ member.link_3 }}">
                        {{ section.settings.icon_3 }}
                    </a>
                {% endif %}

                {% if member.link_4 != blank %}
                    <a href="{{ member.link_4 }}">
                        {{ section.settings.icon_4 }}
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>